<div class="admin-header">
  <h1><%= integration.name %></h1>
  <a href="/admin/integrations" class="btn btn-sm">← К списку</a>
</div>

<% if (saved) { %><div class="admin-alert admin-alert-ok">✓ Настройки сохранены</div><% } %>
<% if (typeof error !== 'undefined' && error) { %><div class="admin-alert" style="background:#fee2e2;color:#991b1b"><%= error %></div><% } %>

<div class="integration-form-grid">

  <form method="post" action="/admin/integrations/<%= integration.slug %>" class="admin-form">
    <fieldset class="full">
      <legend>Общие</legend>

      <label class="checkbox-label" style="font-size:15px;padding:12px 14px;background:#f0fdf4;border-radius:8px;border:1px solid #bbf7d0">
        <input type="checkbox" name="enabled" <%= integration.enabled ? 'checked' : '' %>>
        <strong>Интеграция активна</strong>
      </label>

      <div class="form-row" style="margin-top:16px">
        <label>
          <span>
            Направление синхронизации
            <i class="info-tip" data-tip="Импорт: забираем товары/заказы с маркетплейса. Экспорт: отправляем ваш каталог на маркетплейс. Двусторонняя: и то, и другое."></i>
          </span>
          <select name="direction">
            <option value="both"     <%= integration.direction === 'both'     ? 'selected' : '' %>>Двусторонняя (импорт + экспорт)</option>
            <option value="import"   <%= integration.direction === 'import'   ? 'selected' : '' %>>Только импорт (забрать с МП)</option>
            <option value="export"   <%= integration.direction === 'export'   ? 'selected' : '' %>>Только экспорт (отправить на МП)</option>
          </select>
        </label>
      </div>

      <label>
        <span>
          Стратегия при конфликте (товар с таким SKU уже есть)
          <i class="info-tip" data-tip="При «Обновить»: существующие товары обновляются, новые добавляются, лишние не трогаются. При «Перезаписать»: полная замена — старые данные могут быть потеряны. При «Пропустить»: только новые, существующие не меняются."></i>
        </span>
        <select name="strategy">
          <option value="merge"      <%= integration.strategy === 'merge'      ? 'selected' : '' %>>Обновить существующие, добавить новые</option>
          <option value="overwrite"  <%= integration.strategy === 'overwrite'  ? 'selected' : '' %>>Перезаписать всё (может удалить лишнее)</option>
          <option value="skip"       <%= integration.strategy === 'skip'       ? 'selected' : '' %>>Пропустить существующие</option>
        </select>
      </label>
    </fieldset>

    <fieldset class="full">
      <legend>🔑 API-ключи <%= integration.name %></legend>
      <p style="font-size:13px;color:#6b7280;margin:0 0 12px">
        Получите ключи в личном кабинете продавца. Без них работает только экспорт/импорт через YML/CSV файлы.
      </p>

      <% if (integration.slug === 'ozon') { %>
        <div class="form-row">
          <label>Client-Id
            <input type="text" name="config[clientId]" value="<%= config.clientId || '' %>" placeholder="123456">
          </label>
          <label>Api-Key
            <input type="password" name="config[apiKey]" value="<%= config.apiKey || '' %>" placeholder="••••••••-••••-••••-••••-••••••••••••">
          </label>
        </div>
        <div class="form-row">
          <label>Warehouse ID
            <input type="text" name="config[warehouseId]" value="<%= config.warehouseId || '' %>">
          </label>
        </div>

      <% } else if (integration.slug === 'wildberries') { %>
        <label>Api-Key (JWT)
          <input type="password" name="config[apiKey]" value="<%= config.apiKey || '' %>" placeholder="eyJhbGciOiJFUzI1NiIs...">
        </label>
        <div class="form-row">
          <label>Supplier ID
            <input type="text" name="config[supplierId]" value="<%= config.supplierId || '' %>">
          </label>
          <label>Warehouse ID
            <input type="text" name="config[warehouseId]" value="<%= config.warehouseId || '' %>">
          </label>
        </div>

      <% } else if (integration.slug === 'yandex') { %>
        <div class="form-row">
          <label>Campaign ID
            <input type="text" name="config[campaignId]" value="<%= config.campaignId || '' %>">
          </label>
          <label>OAuth Token
            <input type="password" name="config[token]" value="<%= config.token || '' %>">
          </label>
        </div>

      <% } else if (integration.slug === 'sbermarket') { %>
        <p style="font-size:12.5px;color:#6b7280;margin:0 0 12px;padding:10px 14px;background:#f0fdf4;border-radius:8px;border-left:3px solid #16a34a">
          🔑 <strong>Ключи Сбермаркета (Купер)</strong> выдаются в партнёрском кабинете <code>seller.kuiper.ru</code>
          после подписания договора. Без ключей работает только ручной экспорт YML/CSV.
        </p>
        <div class="form-row">
          <label>API-Key
            <input type="password" name="config[apiKey]" value="<%= config.apiKey || '' %>" placeholder="••••••••-••••-••••-••••-••••••••••••">
          </label>
          <label>Partner ID
            <input type="text" name="config[partnerId]" value="<%= config.partnerId || '' %>" placeholder="12345">
          </label>
        </div>
        <div class="form-row">
          <label>Warehouse ID
            <input type="text" name="config[warehouseId]" value="<%= config.warehouseId || '' %>" placeholder="SBM-MSQ-01">
          </label>
          <label>Assortment ID (опционально)
            <input type="text" name="config[assortmentId]" value="<%= config.assortmentId || '' %>">
          </label>
        </div>

      <% } else { %>
        <label>Config (JSON)
          <textarea name="config" rows="4" style="font-family:monospace"><%= integration.config %></textarea>
        </label>
      <% } %>
    </fieldset>

    <div class="form-actions">
      <button type="submit" class="btn">💾 Сохранить</button>
    </div>
  </form>

  <div class="integration-side">
    <section class="order-block">
      <header class="order-block-head">
        <h2>📤 Экспорт</h2>
      </header>
      <p style="color:#6b7280;font-size:13.5px;line-height:1.5;margin:0 0 14px">
        Товаров опубликованных: <strong><%= counts.publishedProducts %></strong><br>
        Из них с остатком: <strong><%= counts.withStock %></strong>
      </p>
      <a href="/admin/integrations/<%= integration.slug %>/export/yml" class="btn" style="width:100%;justify-content:center">
        📤 Скачать YML (<%= counts.withStock %>)
      </a>
      <a href="/admin/integrations/<%= integration.slug %>/export/yml?all=1" class="btn btn-sm btn-outline" style="width:100%;justify-content:center;margin-top:8px">
        📤 YML со всеми (<%= counts.publishedProducts %>)
      </a>
      <a href="/admin/integrations/<%= integration.slug %>/export/csv" class="btn btn-sm btn-muted" style="width:100%;justify-content:center;margin-top:8px">
        📊 Скачать CSV
      </a>
    </section>

    <%# API-синхронизация %>
    <% if (integration.slug === 'ozon' || integration.slug === 'wildberries') { %>
      <section class="order-block order-block-api" style="margin-top:16px">
        <header class="order-block-head">
          <h2>
            ⚡ API-синхронизация
            <i class="info-tip info-tip-left" data-tip="Только импорт заказов С маркетплейса. Ваши заказы со своего сайта (source: own) НИКОГДА не отправляются на маркетплейсы — они остаются в вашей базе. Через API можно только забирать данные, а не отправлять свои заказы."></i>
          </h2>
        </header>

        <div style="margin-bottom:12px">
          <div id="api-status" style="font-size:13px;padding:10px 12px;background:#f9fafb;border-radius:8px;color:#6b7280">
            Проверка подключения…
          </div>
        </div>

        <button type="button" class="btn btn-sm" style="width:100%;justify-content:center;margin-bottom:8px" id="btn-test-api">
          🔍 Проверить подключение
        </button>

        <button type="button" class="btn" style="width:100%;justify-content:center;background:#16a34a" id="btn-sync-orders">
          ⚡ Забрать заказы (24 ч)
        </button>

        <select id="sync-hours" style="width:100%;margin-top:8px;padding:8px 12px;border:1px solid #d1d5db;border-radius:6px;font:inherit;font-size:13px">
          <option value="1">за последний час</option>
          <option value="6">за 6 часов</option>
          <option value="24" selected>за 24 часа</option>
          <option value="72">за 3 дня</option>
          <option value="168">за неделю</option>
        </select>

        <div id="sync-result" style="margin-top:10px;font-size:13px"></div>
      </section>

      <%# Синхронизация остатков и цен %>
      <section class="order-block order-block-stock" style="margin-top:16px">
        <header class="order-block-head">
          <h2>
            📦 Остатки и цены
            <i class="info-tip info-tip-left" data-tip="Отправляем ваши актуальные остатки и цены на маркетплейс. Обновляются только товары, у которых заполнен External ID в карточке товара (поле «Внешние ID»). Заказы со своего сайта сюда не отправляются."></i>
          </h2>
        </header>

        <p style="color:#6b7280;font-size:13px;margin:0 0 12px">
          Обновляем данные <strong>только для товаров с заполненным External ID</strong>.
          Остальные останутся без изменений.
        </p>

        <button type="button" class="btn btn-sm" style="width:100%;justify-content:center;margin-bottom:8px;background:#2563eb" id="btn-sync-stocks">
          📦 Обновить остатки
        </button>

        <button type="button" class="btn btn-sm" style="width:100%;justify-content:center;background:#7c3aed" id="btn-sync-prices">
          💰 Обновить цены
        </button>

        <div id="stock-result" style="margin-top:10px;font-size:13px"></div>
      </section>

      <script>
      (function () {
        var slug = '<%= integration.slug %>';
        var stocksBtn = document.getElementById('btn-sync-stocks');
        var pricesBtn = document.getElementById('btn-sync-prices');
        var resultEl = document.getElementById('stock-result');

        function run(action, endpoint, btn, label) {
          if (!confirm('Обновить ' + label + ' на маркетплейсе?\n\nДанные отправятся для всех товаров с заполненным External ID.')) return;
          btn.disabled = true;
          var origText = btn.textContent;
          btn.textContent = '⏳ Обновление…';
          resultEl.innerHTML = '';

          fetch('/admin/integrations/' + slug + '/' + endpoint, { method: 'POST' })
            .then(function (r) { return r.json(); })
            .then(function (d) {
              btn.disabled = false;
              btn.textContent = origText;

              if (!d.ok) {
                resultEl.innerHTML = '<div style="color:#dc2626;padding:10px 12px;background:#fef2f2;border-radius:8px">✗ ' + (d.error || 'Ошибка') + '</div>';
                return;
              }

              var errorsHtml = '';
              if (d.errors && d.errors.length) {
                errorsHtml = '<details style="margin-top:8px"><summary style="cursor:pointer;color:#dc2626">Показать ошибки (' + d.errors.length + ')</summary><ul style="margin:6px 0 0;padding-left:18px;font-size:12px">';
                d.errors.forEach(function (e) { errorsHtml += '<li>' + e + '</li>'; });
                errorsHtml += '</ul></details>';
              }

              resultEl.innerHTML =
                '<div style="padding:10px 12px;background:#f0fdf4;border-radius:8px;color:#166534">' +
                  '<strong>✓ Готово</strong><br>' +
                  'Всего товаров: ' + d.total + '<br>' +
                  'Обновлено: ' + d.updated + '<br>' +
                  (d.failed ? '<span style="color:#dc2626">Ошибок: ' + d.failed + '</span>' : '') +
                '</div>' + errorsHtml;
            })
            .catch(function (e) {
              btn.disabled = false;
              btn.textContent = origText;
              resultEl.innerHTML = '<div style="color:#dc2626">✗ ' + e.message + '</div>';
            });
        }

        stocksBtn.addEventListener('click', function () { run('stocks', 'sync-stocks', stocksBtn, 'остатки'); });
        pricesBtn.addEventListener('click', function () { run('prices', 'sync-prices', pricesBtn, 'цены'); });
      })();
      </script>

      <script>
      (function () {
        var slug = '<%= integration.slug %>';
        var statusEl = document.getElementById('api-status');
        var testBtn = document.getElementById('btn-test-api');
        var syncBtn = document.getElementById('btn-sync-orders');
        var hoursSel = document.getElementById('sync-hours');
        var resultEl = document.getElementById('sync-result');

        // Автопроверка при загрузке
        fetch('/admin/integrations/' + slug + '/test')
          .then(function (r) { return r.json(); })
          .then(function (d) {
            if (d.ok) {
              statusEl.style.background = '#f0fdf4';
              statusEl.style.color = '#166534';
              statusEl.innerHTML = '✓ Подключение работает' + (d.categories ? ' · категорий: ' + d.categories : '');
            } else {
              statusEl.style.background = '#fef2f2';
              statusEl.style.color = '#991b1b';
              statusEl.innerHTML = '✗ ' + (d.error || 'Не подключено');
            }
          })
          .catch(function () {
            statusEl.innerHTML = '✗ Ошибка проверки';
          });

        testBtn.addEventListener('click', function () {
          statusEl.innerHTML = 'Проверка…';
          statusEl.style.background = '#f9fafb';
          statusEl.style.color = '#6b7280';
          fetch('/admin/integrations/' + slug + '/test')
            .then(function (r) { return r.json(); })
            .then(function (d) {
              if (d.ok) {
                statusEl.style.background = '#f0fdf4';
                statusEl.style.color = '#166534';
                statusEl.innerHTML = '✓ Подключение работает';
              } else {
                statusEl.style.background = '#fef2f2';
                statusEl.style.color = '#991b1b';
                statusEl.innerHTML = '✗ ' + (d.error || 'Ошибка');
              }
            });
        });

        syncBtn.addEventListener('click', function () {
          var hours = hoursSel.value;
          syncBtn.disabled = true;
          syncBtn.textContent = '⏳ Синхронизация…';
          resultEl.innerHTML = '';

          fetch('/admin/integrations/' + slug + '/sync', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ hours: Number(hours) })
          })
            .then(function (r) { return r.json(); })
            .then(function (d) {
              syncBtn.disabled = false;
              syncBtn.textContent = '⚡ Забрать заказы (' + hours + ' ч)';

              if (!d.ok) {
                resultEl.innerHTML = '<div style="color:#dc2626">✗ ' + (d.error || 'Ошибка') + '</div>';
                return;
              }

              resultEl.innerHTML =
                '<div style="padding:10px 12px;background:#f0fdf4;border-radius:8px;color:#166534">' +
                  '<strong>✓ Готово</strong><br>' +
                  'Создано: ' + d.created + '<br>' +
                  'Пропущено: ' + d.skipped + '<br>' +
                  (d.failed ? '<span style="color:#dc2626">Ошибок: ' + d.failed + '</span>' : '') +
                '</div>';
            })
            .catch(function (e) {
              syncBtn.disabled = false;
              syncBtn.textContent = '⚡ Забрать заказы';
              resultEl.innerHTML = '<div style="color:#dc2626">✗ ' + e.message + '</div>';
            });
        });
      })();
      </script>
    <% } %>

    <section class="order-block" style="margin-top:16px">
      <header class="order-block-head">
        <h2>📥 Импорт из файла</h2>
      </header>
      <p style="color:#6b7280;font-size:13.5px;line-height:1.5;margin:0 0 14px">
        Загрузите YML с маркетплейса — товары добавятся, существующие обновятся по SKU.
      </p>
      <a href="/admin/import" class="btn" style="width:100%;justify-content:center;background:#6b7280">
        📥 Загрузить файл
      </a>
    </section>

    <% if (logs && logs.length) { %>
      <section class="order-block" style="margin-top:16px">
        <header class="order-block-head">
          <h2>📜 История</h2>
        </header>
        <ul style="list-style:none;padding:0;margin:0;font-size:13px">
          <% logs.slice(0, 8).forEach(l => { %>
            <li style="padding:8px 0;border-bottom:1px solid #f3f4f6;display:flex;justify-content:space-between;gap:8px">
              <div>
                <div style="font-weight:500"><%= l.action.toUpperCase() %> · <%= l.direction %></div>
                <div style="font-size:11.5px;color:#9ca3af"><%= l.startedAt.toLocaleString('ru-RU') %></div>
              </div>
              <div style="font-size:12px;color:<%= l.status === 'success' ? '#16a34a' : '#dc2626' %>;font-weight:600">
                <%= l.status %>
              </div>
            </li>
          <% }) %>
        </ul>
      </section>
    <% } %>
  </div>

</div>
