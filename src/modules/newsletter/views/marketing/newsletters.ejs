<div class="admin-header">
  <h1>📨 Рассылки</h1>
  <a href="/admin/marketing/newsletters/new" class="btn">+ Новая рассылка</a>
</div>
<p class="admin-hint">
  Создайте рассылку, отправьте всем подписчикам. Поддерживается email и Telegram.
</p>

<div class="admin-table-wrap">
  <table class="admin-table">
    <thead>
      <tr>
        <th style="width:50px">ID</th>
        <th>Тема</th>
        <th style="width:220px">Каналы</th>
        <th style="width:140px;text-align:center">Статус</th>
        <th style="width:110px;text-align:center">Отправлено</th>
        <th style="width:110px;text-align:center">Доставлено</th>
        <th style="width:100px;text-align:center">Ошибок</th>
        <th style="width:160px">Дата</th>
        <th style="width:180px;text-align:right">Действия</th>
      </tr>
    </thead>
    <tbody>
      <% items.forEach(n => {
           let ch = [];
           try { ch = JSON.parse(n.channels); } catch (e) {}
      %>
        <tr>
          <td><%= n.id %></td>
          <td><div class="cell-title"><%= n.subject %></div></td>
          <td>
            <% ch.forEach(c => { %>
              <span class="badge"><%= c === 'email' ? '✉ Email' : '📨 Telegram' %></span>
            <% }) %>
          </td>
          <td style="text-align:center">
            <% if (n.status === 'sent') { %><span class="badge badge-paid">✓ Отправлено</span>
            <% } else { %><span class="badge">Черновик</span><% } %>
          </td>
          <td style="text-align:center"><%= n.recipients %></td>
          <td style="text-align:center"><%= n.delivered %></td>
          <td style="text-align:center">
            <%= n.failed > 0 ? n.failed : '—' %>
          </td>
          <td><%= n.sentAt ? n.sentAt.toLocaleString('ru-RU') : n.createdAt.toLocaleDateString('ru-RU') %></td>
          <td class="cell-actions">
            <a href="/admin/marketing/newsletters/<%= n.id %>" class="btn btn-sm">Открыть</a>
            <form method="post" action="/admin/marketing/newsletters/<%= n.id %>/delete" onsubmit="return confirm('Удалить рассылку?')" class="inline-form">
              <button class="btn btn-sm btn-danger" title="Удалить">×</button>
            </form>
          </td>
        </tr>
      <% }) %>
      <% if (!items.length) { %>
        <tr><td colspan="9" style="text-align:center;color:#9ca3af;padding:40px">Рассылок пока нет</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
