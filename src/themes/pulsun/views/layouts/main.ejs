<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= typeof title !== 'undefined' ? title + ' — PULSUN' : 'PULSUN — больше, чем просто сироп' %></title>
<meta name="description" content="<%= typeof metaDesc !== 'undefined' ? metaDesc : 'Сиропы PULSUN без сахара, 8 вкусов, натуральные ароматизаторы.' %>">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700;900&family=Inter:wght@400;500;600&family=Caveat:wght@500&display=swap" rel="stylesheet">

<link rel="stylesheet" href="/theme/pulsun/assets/css/tokens.css?v=1789759537">
<link rel="stylesheet" href="/theme/pulsun/assets/css/base.css?v=1789759537">
<link rel="stylesheet" href="/theme/pulsun/assets/css/header.css?v=1789759537">
<link rel="stylesheet" href="/theme/pulsun/assets/css/footer.css?v=1789759537">
<link rel="stylesheet" href="/theme/pulsun/assets/css/sections.css?v=1789759537">
<link rel="stylesheet" href="/theme/pulsun/assets/css/hero.css?v=1789759537">
<link rel="stylesheet" href="/theme/pulsun/assets/css/catalog.css?v=1789759537">
<%- typeof extraCss !== 'undefined' ? extraCss : '' %>
<% if (typeof preloader !== 'undefined' && preloader) { %>
<link rel="stylesheet" href="/modules/preloader/preloader.css?v=1">
<% } %>
</head>
<body class="theme-pulsun">
<% if (typeof preloader !== 'undefined' && preloader) { %>
<div class="preloader preloader--<%= preloader.style %>"
     id="shopPreloader"
     data-duration="<%= preloader.duration %>"
     style="background: <%= preloader.bg %>;">
  <div class="preloader__logo" style="color: <%= preloader.textColor %>;">
    <%= preloader.text %>
  </div>

  <% if (preloader.style === 'logo-dots') { %>
    <div class="preloader__dots">
      <span class="preloader__dot" style="background: <%= preloader.accent %>;"></span>
      <span class="preloader__dot" style="background: <%= preloader.accent %>;"></span>
      <span class="preloader__dot" style="background: <%= preloader.accent %>;"></span>
    </div>
  <% } else if (preloader.style === 'logo-ring') { %>
    <div class="preloader__ring" style="border-top-color: <%= preloader.accent %>; border-right-color: <%= preloader.accent %>;"></div>
  <% } else if (preloader.style === 'logo-bar') { %>
    <div class="preloader__bar" style="background: rgba(0,0,0,0.08);">
      <div class="preloader__bar-fill" style="background: <%= preloader.accent %>;"></div>
    </div>
  <% } %>
</div>
<script src="/modules/preloader/preloader.js"></script>
<% } %>

<%- include('../shop/partials/header') %>

<main class="main">
  <%- body %>
</main>

<%- include('../shop/partials/footer') %>

<script src="/theme/pulsun/assets/js/main.js" defer></script>
</body>
</html>
