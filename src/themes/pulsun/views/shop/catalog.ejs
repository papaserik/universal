<%
  // Дефолты
  if (typeof sort === 'undefined') sort = 'popular';
  if (typeof total === 'undefined') total = (typeof products !== 'undefined' && products.length) ? products.length : 0;
  if (typeof categories === 'undefined') categories = [];
  if (typeof brands === 'undefined') brands = [];
  if (typeof tags === 'undefined') tags = [];
  if (typeof priceMin === 'undefined') priceMin = '';
  if (typeof priceMax === 'undefined') priceMax = '';
  if (typeof selectedBrands === 'undefined') selectedBrands = [];
  if (typeof selectedTags === 'undefined') selectedTags = [];
  if (typeof activeFilters === 'undefined') activeFilters = 0;
  if (typeof breadcrumbs === 'undefined') breadcrumbs = [];
  if (typeof products === 'undefined') products = [];
  if (typeof cat === 'undefined') cat = null;
%>
<div class="catalog-page">
  <div class="container">

    <%# Хлебные крошки %>
    <% if (breadcrumbs.length) { %>
      <nav class="catalog-breadcrumbs" aria-label="Хлебные крошки">
        <% breadcrumbs.forEach(function (b, i) { %>
          <% if (i > 0) { %><span class="catalog-breadcrumbs__sep">·</span><% } %>
          <% if (b.url && i < breadcrumbs.length - 1) { %>
            <a href="<%= b.url %>"><%= b.title %></a>
          <% } else { %>
            <span><%= b.title %></span>
          <% } %>
        <% }); %>
      </nav>
    <% } %>

    <header class="catalog-heading">
      <div>
        <div class="catalog-heading__eyebrow">PULSUN · КОЛЛАГЕНОВЫЕ СИРОПЫ</div>
        <h1 class="catalog-title">Все вкусы PULSUN</h1>
        <p class="catalog-heading__lead">Без сахара. Восемь вкусов для кофе, десертов и любимых напитков.</p>
      </div>
      <a href="#catalog-products" class="catalog-heading__link">Выбрать вкус ↓</a>
    </header>

        <%# ═══ Toolbar ═══ %>
    <div class="catalog-toolbar">
      <div class="catalog-toolbar__left">
        <button type="button" class="catalog-toolbar__filters-btn">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="14" y2="12"/><line x1="4" y1="18" x2="10" y2="18"/></svg>
          Фильтры
          <% if (activeFilters > 0) { %><span class="catalog-toolbar__filters-count"><%= activeFilters %></span><% } %>
        </button>

        <div class="catalog-toolbar__sort">
          <label for="sort-select">Сортировка:</label>
          <select id="sort-select" class="catalog-toolbar__sort-select" data-sort>
            <option value="popular" <%= sort === 'popular' ? 'selected' : '' %>>По популярности</option>
            <option value="new" <%= sort === 'new' ? 'selected' : '' %>>Сначала новые</option>
            <option value="price-asc" <%= sort === 'price-asc' ? 'selected' : '' %>>Цена: по возрастанию</option>
            <option value="price-desc" <%= sort === 'price-desc' ? 'selected' : '' %>>Цена: по убыванию</option>
          </select>
        </div>
      </div>

      <div class="catalog-toolbar__right">
        <div class="catalog-toolbar__total"><%= total %> товаров</div>
        <div class="catalog-toolbar__view">
          <button type="button" class="catalog-view-btn is-active" data-view="grid" aria-label="Сетка">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="3" y="3" width="8" height="8" rx="1.5"/><rect x="13" y="3" width="8" height="8" rx="1.5"/>
              <rect x="3" y="13" width="8" height="8" rx="1.5"/><rect x="13" y="13" width="8" height="8" rx="1.5"/>
            </svg>
          </button>
          <button type="button" class="catalog-view-btn" data-view="list" aria-label="Список">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="3" y="4" width="18" height="6" rx="1.5"/><rect x="3" y="14" width="18" height="6" rx="1.5"/>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <%# ═══ Строка фильтров-чипов ═══ %>
    <div class="catalog-filters-row">

      <%# Категория %>
      <% if (categories.length) { %>
        <div class="catalog-filter-chip" data-chip>
          <button type="button" class="catalog-filter-chip__btn">
            <%= cat ? cat.name : 'Категория' %>
            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
          </button>
          <div class="catalog-filter-chip__dropdown">
            <a href="/catalog" class="catalog-filter-chip__item <%= !cat ? 'is-active' : '' %>">Все категории</a>
            <% categories.forEach(function (c) { %>
              <a href="/catalog/<%= c.slug %>" class="catalog-filter-chip__item <%= cat && cat.id === c.id ? 'is-active' : '' %>">
                <%= c.name %>
              </a>
            <% }); %>
          </div>
        </div>
      <% } %>

      <%# Цена %>
      <div class="catalog-filter-chip" data-chip>
        <button type="button" class="catalog-filter-chip__btn">
          Цена
          <% if (priceMin || priceMax) { %><span class="catalog-filter-chip__dot"></span><% } %>
          <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <div class="catalog-filter-chip__dropdown">
          <form method="get" class="catalog-filter-chip__price">
            <input type="number" name="priceMin" placeholder="от" value="<%= priceMin %>">
            <span>—</span>
            <input type="number" name="priceMax" placeholder="до" value="<%= priceMax %>">
            <button type="submit">Применить</button>
          </form>
        </div>
      </div>

      <%# Бренд %>
      <% if (brands.length) { %>
        <div class="catalog-filter-chip" data-chip>
          <button type="button" class="catalog-filter-chip__btn">
            Бренд
            <% if (selectedBrands.length) { %><span class="catalog-filter-chip__dot"></span><% } %>
            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
          </button>
          <div class="catalog-filter-chip__dropdown">
            <form method="get">
              <% brands.forEach(function (b) { %>
                <label class="catalog-filter-chip__check">
                  <input type="checkbox" name="brand" value="<%= b.slug %>" <%= selectedBrands.includes(b.slug) ? 'checked' : '' %>>
                  <span><%= b.name %></span>
                </label>
              <% }); %>
              <button type="submit" class="catalog-filter-chip__submit">Применить</button>
            </form>
          </div>
        </div>
      <% } %>

      <%# Теги %>
      <% if (tags.length) { %>
        <div class="catalog-filter-chip" data-chip>
          <button type="button" class="catalog-filter-chip__btn">
            Теги
            <% if (selectedTags.length) { %><span class="catalog-filter-chip__dot"></span><% } %>
            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
          </button>
          <div class="catalog-filter-chip__dropdown">
            <form method="get">
              <% tags.forEach(function (t) { %>
                <label class="catalog-filter-chip__check">
                  <input type="checkbox" name="tag" value="<%= t.slug %>" <%= selectedTags.includes(t.slug) ? 'checked' : '' %>>
                  <span><%= t.name %></span>
                </label>
              <% }); %>
              <button type="submit" class="catalog-filter-chip__submit">Применить</button>
            </form>
          </div>
        </div>
      <% } %>

      <%# Сброс %>
      <% if (activeFilters > 0) { %>
        <a href="/catalog" class="catalog-filter-chip__reset">✕ Сбросить</a>
      <% } %>
    </div>

    <%# ═══ Сетка товаров ═══ %>
    <% if (products.length) { %>
      <div class="catalog-grid" data-grid id="catalog-products">
        <% products.forEach(function (p) { %>
          <%- include('partials/product-card', { p: p }) %>
        <% }); %>
      </div>
    <% } else { %>
      <div class="catalog-empty">
        <div class="catalog-empty__icon">🌿</div>
        <p>По вашим фильтрам ничего не найдено</p>
        <a href="/catalog" class="btn btn--primary">Сбросить фильтры</a>
      </div>
    <% } %>

  </div>
</div>

<script>
(function(){
  var chips = Array.from(document.querySelectorAll('[data-chip]'));

  chips.forEach(function(chip){
    var btn = chip.querySelector('.catalog-filter-chip__btn');
    if (!btn) return;
    btn.setAttribute('aria-expanded', 'false');
    btn.addEventListener('click', function(e){
      e.stopPropagation();
      chips.forEach(function(c){
        if (c !== chip) {
          c.classList.remove('is-open');
          var other = c.querySelector('.catalog-filter-chip__btn');
          if (other) other.setAttribute('aria-expanded', 'false');
        }
      });
      var opened = chip.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', opened ? 'true' : 'false');
    });
    var dd = chip.querySelector('.catalog-filter-chip__dropdown');
    if (dd) dd.addEventListener('click', function(e){ e.stopPropagation(); });
  });

  document.addEventListener('click', function(){
    chips.forEach(function(c){
      c.classList.remove('is-open');
      var b = c.querySelector('.catalog-filter-chip__btn');
      if (b) b.setAttribute('aria-expanded', 'false');
    });
  });
  document.addEventListener('keydown', function(e){
    if (e.key === 'Escape') document.dispatchEvent(new Event('click'));
  });

  // Любая форма фильтра меняет только свои поля, остальные параметры сохраняются.
  document.querySelectorAll('.catalog-filter-chip__dropdown form').forEach(function(form){
    form.addEventListener('submit', function(e){
      e.preventDefault();
      var url = new URL(window.location.href);
      var data = new FormData(form);
      var names = Array.from(form.querySelectorAll('[name]')).map(function(el){ return el.name; });
      names.forEach(function(name){ url.searchParams.delete(name); });
      data.forEach(function(value, key){
        if (String(value).trim() !== '') url.searchParams.append(key, value);
      });
      url.searchParams.delete('page');
      window.location.href = url.pathname + (url.searchParams.toString() ? '?' + url.searchParams.toString() : '');
    });
  });

  var sort = document.querySelector('[data-sort]');
  if (sort) {
    sort.addEventListener('change', function(){
      var url = new URL(window.location.href);
      if (this.value === 'popular') url.searchParams.delete('sort');
      else url.searchParams.set('sort', this.value);
      url.searchParams.delete('page');
      window.location.href = url.pathname + (url.searchParams.toString() ? '?' + url.searchParams.toString() : '');
    });
  }

  // Вид сетка/список запоминаем локально.
  var grid = document.querySelector('[data-grid]');
  var viewButtons = document.querySelectorAll('.catalog-view-btn');
  function setView(view) {
    if (!grid) return;
    grid.classList.toggle('catalog-grid--list', view === 'list');
    viewButtons.forEach(function(btn){
      var active = btn.getAttribute('data-view') === view;
      btn.classList.toggle('is-active', active);
      btn.setAttribute('aria-pressed', active ? 'true' : 'false');
    });
    try { localStorage.setItem('pulsunCatalogView', view); } catch(e) {}
  }
  var savedView = 'grid';
  try { savedView = localStorage.getItem('pulsunCatalogView') || 'grid'; } catch(e) {}
  setView(savedView);
  viewButtons.forEach(function(btn){
    btn.addEventListener('click', function(){ setView(this.getAttribute('data-view')); });
  });

  // На мобильном кнопка «Фильтры» ведёт к чипам.
  var filtersBtn = document.querySelector('.catalog-toolbar__filters-btn');
  var filtersRow = document.querySelector('.catalog-filters-row');
  if (filtersBtn && filtersRow) {
    filtersBtn.addEventListener('click', function(){
      filtersRow.scrollIntoView({ behavior: 'smooth', block: 'center' });
      var first = filtersRow.querySelector('.catalog-filter-chip__btn');
      if (first) setTimeout(function(){ first.click(); }, 250);
    });
  }

  // Быстрое добавление в корзину из карточки.
  document.addEventListener('click', function(e){
    var btn = e.target.closest('[data-quick-cart]');
    if (!btn) return;
    e.preventDefault();
    if (btn.disabled) return;
    var old = btn.textContent;
    btn.disabled = true;
    fetch('/cart/add', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ productId: Number(btn.dataset.quickCart), qty: 1 })
    }).then(function(r){ return r.json(); }).then(function(d){
      btn.textContent = d.ok ? 'Добавлено ✓' : 'Не удалось';
      document.dispatchEvent(new CustomEvent('cart:updated', { detail: d }));
      setTimeout(function(){ btn.textContent = old; btn.disabled = false; }, 1400);
    }).catch(function(){
      btn.textContent = 'Не удалось';
      setTimeout(function(){ btn.textContent = old; btn.disabled = false; }, 1400);
    });
  });
})();
</script>
