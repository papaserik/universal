<%
  // Дефолты
  if (typeof sort === 'undefined') sort = 'popular';
  if (typeof total === 'undefined') total = (typeof products !== 'undefined' && products.length) ? products.length : 0;
  if (typeof categories === 'undefined') categories = [];
  if (typeof brands === 'undefined') brands = [];
  if (typeof tags === 'undefined') tags = [];
  if (typeof priceMin === 'undefined') priceMin = '';
  if (typeof priceMax === 'undefined') priceMax = '';
  if (typeof selectedBrands === 'undefined') selectedBrands = [];
  if (typeof selectedTags === 'undefined') selectedTags = [];
  if (typeof activeFilters === 'undefined') activeFilters = 0;
  if (typeof breadcrumbs === 'undefined') breadcrumbs = [];
  if (typeof products === 'undefined') products = [];
  if (typeof cat === 'undefined') cat = null;
%>
<div class="catalog-page">
  <div class="container">

    <%# Хлебные крошки %>
    <% if (breadcrumbs.length) { %>
      <nav class="catalog-breadcrumbs" aria-label="Хлебные крошки">
        <% breadcrumbs.forEach(function (b, i) { %>
          <% if (i > 0) { %><span class="catalog-breadcrumbs__sep">·</span><% } %>
          <% if (b.url && i < breadcrumbs.length - 1) { %>
            <a href="<%= b.url %>"><%= b.title %></a>
          <% } else { %>
            <span><%= b.title %></span>
          <% } %>
        <% }); %>
      </nav>
    <% } %>

    <%# ═══ Toolbar ═══ %>
    <div class="catalog-toolbar">
      <div class="catalog-toolbar__left">
        <button type="button" class="catalog-toolbar__filters-btn">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="14" y2="12"/><line x1="4" y1="18" x2="10" y2="18"/></svg>
          Фильтры
          <% if (activeFilters > 0) { %><span class="catalog-toolbar__filters-count"><%= activeFilters %></span><% } %>
        </button>

        <div class="catalog-toolbar__sort">
          <label for="sort-select">Сортировка:</label>
          <select id="sort-select" class="catalog-toolbar__sort-select" data-sort>
            <option value="popular" <%= sort === 'popular' ? 'selected' : '' %>>По популярности</option>
            <option value="new" <%= sort === 'new' ? 'selected' : '' %>>Сначала новые</option>
            <option value="price-asc" <%= sort === 'price-asc' ? 'selected' : '' %>>Цена: по возрастанию</option>
            <option value="price-desc" <%= sort === 'price-desc' ? 'selected' : '' %>>Цена: по убыванию</option>
          </select>
        </div>
      </div>

      <div class="catalog-toolbar__right">
        <div class="catalog-toolbar__total"><%= total %> товаров</div>
        <div class="catalog-toolbar__view">
          <button type="button" class="catalog-view-btn is-active" data-view="grid" aria-label="Сетка">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="3" y="3" width="8" height="8" rx="1.5"/><rect x="13" y="3" width="8" height="8" rx="1.5"/>
              <rect x="3" y="13" width="8" height="8" rx="1.5"/><rect x="13" y="13" width="8" height="8" rx="1.5"/>
            </svg>
          </button>
          <button type="button" class="catalog-view-btn" data-view="list" aria-label="Список">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="3" y="4" width="18" height="6" rx="1.5"/><rect x="3" y="14" width="18" height="6" rx="1.5"/>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <%# ═══ Строка фильтров-чипов ═══ %>
    <div class="catalog-filters-row">

      <%# Категория %>
      <% if (categories.length) { %>
        <div class="catalog-filter-chip" data-chip>
          <button type="button" class="catalog-filter-chip__btn">
            <%= cat ? cat.name : 'Категория' %>
            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
          </button>
          <div class="catalog-filter-chip__dropdown">
            <a href="/catalog" class="catalog-filter-chip__item <%= !cat ? 'is-active' : '' %>">Все категории</a>
            <% categories.forEach(function (c) { %>
              <a href="/catalog/<%= c.slug %>" class="catalog-filter-chip__item <%= cat && cat.id === c.id ? 'is-active' : '' %>">
                <%= c.name %>
              </a>
            <% }); %>
          </div>
        </div>
      <% } %>

      <%# Цена %>
      <div class="catalog-filter-chip" data-chip>
        <button type="button" class="catalog-filter-chip__btn">
          Цена
          <% if (priceMin || priceMax) { %><span class="catalog-filter-chip__dot"></span><% } %>
          <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <div class="catalog-filter-chip__dropdown">
          <form method="get" class="catalog-filter-chip__price">
            <input type="number" name="priceMin" placeholder="от" value="<%= priceMin %>">
            <span>—</span>
            <input type="number" name="priceMax" placeholder="до" value="<%= priceMax %>">
            <button type="submit">Применить</button>
          </form>
        </div>
      </div>

      <%# Бренд %>
      <% if (brands.length) { %>
        <div class="catalog-filter-chip" data-chip>
          <button type="button" class="catalog-filter-chip__btn">
            Бренд
            <% if (selectedBrands.length) { %><span class="catalog-filter-chip__dot"></span><% } %>
            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
          </button>
          <div class="catalog-filter-chip__dropdown">
            <form method="get">
              <% brands.forEach(function (b) { %>
                <label class="catalog-filter-chip__check">
                  <input type="checkbox" name="brand" value="<%= b.slug %>" <%= selectedBrands.includes(b.slug) ? 'checked' : '' %>>
                  <span><%= b.name %></span>
                </label>
              <% }); %>
              <button type="submit" class="catalog-filter-chip__submit">Применить</button>
            </form>
          </div>
        </div>
      <% } %>

      <%# Теги %>
      <% if (tags.length) { %>
        <div class="catalog-filter-chip" data-chip>
          <button type="button" class="catalog-filter-chip__btn">
            Теги
            <% if (selectedTags.length) { %><span class="catalog-filter-chip__dot"></span><% } %>
            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
          </button>
          <div class="catalog-filter-chip__dropdown">
            <form method="get">
              <% tags.forEach(function (t) { %>
                <label class="catalog-filter-chip__check">
                  <input type="checkbox" name="tag" value="<%= t.slug %>" <%= selectedTags.includes(t.slug) ? 'checked' : '' %>>
                  <span><%= t.name %></span>
                </label>
              <% }); %>
              <button type="submit" class="catalog-filter-chip__submit">Применить</button>
            </form>
          </div>
        </div>
      <% } %>

      <%# Сброс %>
      <% if (activeFilters > 0) { %>
        <a href="/catalog" class="catalog-filter-chip__reset">✕ Сбросить</a>
      <% } %>
    </div>

    <%# ═══ Сетка товаров ═══ %>
    <% if (products.length) { %>
      <div class="catalog-grid" data-grid>
        <% products.forEach(function (p) { %>
          <%- include('partials/product-card', { p: p }) %>
        <% }); %>
      </div>
    <% } else { %>
      <div class="catalog-empty">
        <div class="catalog-empty__icon">🌿</div>
        <p>По вашим фильтрам ничего не найдено</p>
        <a href="/catalog" class="btn btn--primary">Сбросить фильтры</a>
      </div>
    <% } %>

  </div>
</div>

<script>
(function(){
  // Дропдауны фильтров
  document.querySelectorAll('[data-chip]').forEach(function(chip){
    var btn = chip.querySelector('.catalog-filter-chip__btn');
    if (!btn) return;
    btn.addEventListener('click', function(e){
      e.stopPropagation();
      // Закрыть другие
      document.querySelectorAll('[data-chip].is-open').forEach(function(c){
        if (c !== chip) c.classList.remove('is-open');
      });
      chip.classList.toggle('is-open');
    });
  });

  // Закрытие по клику вне
  document.addEventListener('click', function(){
    document.querySelectorAll('[data-chip].is-open').forEach(function(c){
      c.classList.remove('is-open');
    });
  });

  // Сортировка
  var sort = document.querySelector('[data-sort]');
  if (sort) {
    sort.addEventListener('change', function(){
      var url = new URL(window.location.href);
      url.searchParams.set('sort', this.value);
      window.location.href = url.toString();
    });
  }

  // Переключение вида
  document.querySelectorAll('.catalog-view-btn').forEach(function(btn){
    btn.addEventListener('click', function(){
      document.querySelectorAll('.catalog-view-btn').forEach(function(b){ b.classList.remove('is-active'); });
      this.classList.add('is-active');
      var grid = document.querySelector('[data-grid]');
      if (grid) {
        grid.classList.toggle('catalog-grid--list', this.getAttribute('data-view') === 'list');
      }
    });
  });
})();
</script>
