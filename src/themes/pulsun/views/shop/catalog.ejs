<%
  // Дефолты
  if (typeof sort === 'undefined') sort = 'popular';
  if (typeof total === 'undefined') total = (typeof products !== 'undefined' && products.length) ? products.length : 0;
  if (typeof categories === 'undefined') categories = [];
  if (typeof brands === 'undefined') brands = [];
  if (typeof tags === 'undefined') tags = [];
  if (typeof priceMin === 'undefined') priceMin = '';
  if (typeof priceMax === 'undefined') priceMax = '';
  if (typeof selectedBrands === 'undefined') selectedBrands = [];
  if (typeof selectedTags === 'undefined') selectedTags = [];
  if (typeof activeFilters === 'undefined') activeFilters = 0;
  if (typeof breadcrumbs === 'undefined') breadcrumbs = [];
  if (typeof products === 'undefined') products = [];
  if (typeof cat === 'undefined') cat = null;
%>
<div class="catalog-page">
  <div class="container">

    <%# Хлебные крошки %>
    <% if (breadcrumbs.length) { %>
      <nav class="catalog-breadcrumbs" aria-label="Хлебные крошки">
        <% breadcrumbs.forEach(function (b, i) { %>
          <% if (i > 0) { %><span class="catalog-breadcrumbs__sep">·</span><% } %>
          <% if (b.url && i < breadcrumbs.length - 1) { %>
            <a href="<%= b.url %>"><%= b.title %></a>
          <% } else { %>
            <span><%= b.title %></span>
          <% } %>
        <% }); %>
      </nav>
    <% } %>

    <header class="catalog-heading catalog-heading--simple">
      <div>
        <div class="catalog-heading__eyebrow">PULSUN · КОЛЛАГЕНОВЫЕ СИРОПЫ</div>
        <h1 class="catalog-title">Все вкусы PULSUN</h1>
        <p class="catalog-heading__lead">Без сахара. 8 вкусов. На каждый день.</p>
      </div>
    </header>

    <div class="pulsun-flavorbar" aria-label="Выбор вкуса">
      <div class="pulsun-flavorbar__chips">
        <a href="/catalog" class="pulsun-flavor <%= !selectedTags.length ? 'is-active' : '' %>">Все вкусы</a>
        <% tags.forEach(function(t){ %>
          <a href="/catalog?tag=<%= encodeURIComponent(t.slug) %>" class="pulsun-flavor <%= selectedTags.includes(t.slug) ? 'is-active' : '' %>"><%= t.name %></a>
        <% }); %>
      </div>

      <div class="pulsun-flavorbar__meta">
        <span class="pulsun-flavorbar__count"><%= total %> <%= total === 1 ? 'вкус' : (total >= 2 && total <= 4 ? 'вкуса' : 'вкусов') %></span>
        <label class="pulsun-sort">
          <span>Сортировка</span>
          <select class="catalog-toolbar__sort-select" data-sort aria-label="Сортировка товаров">
            <option value="popular" <%= sort === 'popular' ? 'selected' : '' %>>По популярности</option>
            <option value="new" <%= sort === 'new' ? 'selected' : '' %>>Сначала новые</option>
            <option value="price-asc" <%= sort === 'price-asc' ? 'selected' : '' %>>Цена: сначала ниже</option>
            <option value="price-desc" <%= sort === 'price-desc' ? 'selected' : '' %>>Цена: сначала выше</option>
          </select>
        </label>
      </div>
    </div>

    <%# ═══ Сетка товаров ═══ %>
    <% if (products.length) { %>
      <div class="catalog-grid" data-grid id="catalog-products">
        <% products.forEach(function (p) { %>
          <%- include('partials/product-card', { p: p }) %>
        <% }); %>
      </div>
    <% } else { %>
      <div class="catalog-empty">
        <div class="catalog-empty__icon">🌿</div>
        <p>По вашим фильтрам ничего не найдено</p>
        <a href="/catalog" class="btn btn--primary">Сбросить фильтры</a>
      </div>
    <% } %>

  </div>
</div>

<script>
(function(){
  var sort = document.querySelector('[data-sort]');
  if (sort) {
    sort.addEventListener('change', function(){
      var url = new URL(window.location.href);
      if (this.value === 'popular') url.searchParams.delete('sort');
      else url.searchParams.set('sort', this.value);
      window.location.href = url.pathname + (url.searchParams.toString() ? '?' + url.searchParams.toString() : '');
    });
  }

  document.addEventListener('click', function(e){
    var fav = e.target.closest('[data-fav-id]');
    if (fav) {
      e.preventDefault();
      fetch('/favorites/toggle', {
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body:JSON.stringify({productId:Number(fav.dataset.favId)})
      }).then(function(r){ return r.json(); }).then(function(d){
        if (d.ok) {
          fav.classList.toggle('is-active');
          fav.textContent = fav.classList.contains('is-active') ? '♥' : '♡';
        }
      });
      return;
    }

    var btn = e.target.closest('[data-quick-cart]');
    if (!btn || btn.disabled) return;
    e.preventDefault();
    var old = btn.textContent;
    btn.disabled = true;
    fetch('/cart/add', {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({productId:Number(btn.dataset.quickCart),qty:1})
    }).then(function(r){ return r.json(); }).then(function(d){
      btn.textContent = d.ok ? 'Добавлено ✓' : 'Не удалось';
      document.dispatchEvent(new CustomEvent('cart:updated',{detail:d}));
      setTimeout(function(){ btn.textContent=old; btn.disabled=false; },1400);
    }).catch(function(){
      btn.textContent='Не удалось';
      setTimeout(function(){ btn.textContent=old; btn.disabled=false; },1400);
    });
  });
})();
</script>
