<section class="tips">
  <div class="container">

    <header class="tips-head">
      <div>
        <h2 class="tips-head__title">Советы</h2>
        <p class="tips-head__desc">
          Полезные идеи, как сделать ваш день ещё вкуснее с PULSUN.
        </p>
      </div>
      <a href="/blog/category/tips" class="tips-head__link">
        Все советы <span aria-hidden="true">→</span>
      </a>
    </header>

    <div class="tips-grid">
      <% (typeof tipsPosts !== 'undefined' ? tipsPosts : []).forEach(function (t) { %>
        <article class="tip-card">
          <a href="/blog/<%= t.slug %>" class="tip-card__img">
            <%
              var _imgs = [];
              try { _imgs = JSON.parse(t.cover || '[]'); } catch(e) {}
              var _cover = t.cover || null;
            %>
            <% if (_cover) { %>
              <img src="<%= _cover %>" alt="<%= t.title %>" loading="lazy">
            <% } else { %>
              <div class="tip-card__placeholder">📖</div>
            <% } %>
          </a>
          <div class="tip-card__body">
            <h3 class="tip-card__title">
              <a href="/blog/<%= t.slug %>"><%= t.title %></a>
            </h3>
            <p class="tip-card__desc"><%= t.excerpt || '' %></p>
            <a href="/blog/<%= t.slug %>" class="tip-card__link">Читать совет <span aria-hidden="true">→</span></a>
          </div>
        </article>
      <% }); %>

      <% if (typeof tipsPosts === 'undefined' || !tipsPosts.length) { %>
        <p style="color:#6B5847;font-family:var(--font-body);">Советов пока нет. Добавьте посты в категории «Советы» в админке.</p>
      <% } %>
    </div>

  </div>
</section>
