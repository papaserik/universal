<section class="flavors">
  <div class="container">

    <header class="flavors-head">
      <div>
        <h2 class="flavors-head__title">Наши вкусы</h2>
        <p class="flavors-head__desc">
          8 удивительных вкусов, которые делают каждый день вкуснее.<br>
          Выбирайте свой любимый или попробуйте всё!
        </p>
      </div>
      <a href="/catalog" class="flavors-head__link">
        Все вкусы <span aria-hidden="true">→</span>
      </a>
    </header>

    <div class="flavors-scroll">
      <div class="flavors-track">
        <% (typeof flavors !== 'undefined' ? flavors : []).forEach(function (p) { %>
          <a href="/product/<%= p.slug %>" class="flavor-card">
            <div class="flavor-card__img">
              <% if (p.image) { %>
                <img src="<%= p.image %>" alt="<%= p.name %>" loading="lazy">
              <% } else { %>
                <div class="flavor-card__placeholder">🌿</div>
              <% } %>
            </div>
            <div class="flavor-card__name"><%= p.name %></div>
          </a>
        <% }); %>
      </div>
    </div>

  </div>
</section>
