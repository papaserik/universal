<%
  var bg = (typeof banners !== 'undefined' && banners.length) ? banners[0] : null;
  var bgImg = bg && bg.imageUrl ? bg.imageUrl : null;
  var title = bg && bg.title ? bg.title : 'Сиропы PULSUN с коллагеном';
  var subtitle = bg && bg.subtitle ? bg.subtitle : 'Без сахара. 8 вкусов. На каждый день.';
  var desc = bg && bg.body ? bg.body : 'Сиропы без сахара с коллагеном для кофе, десертов и повседневных рецептов. 8 вкусов, приятный вкус и удобное применение каждый день.';
  var ctaText = bg && bg.ctaText ? bg.ctaText : 'Выбрать вкус';
  var ctaUrl = bg && bg.ctaUrl ? bg.ctaUrl : '/catalog';
  var bgStyle = bgImg ? "background-image: url('" + bgImg + "');" : "";
%>
<section class="hero" style="<%- bgStyle %>">
  <div class="hero__overlay"></div>

  <div class="container hero__inner">
    <div class="hero__content">
      <p class="eyebrow">Больше, чем просто вкус</p>

      <h1 class="hero__title"><%- title %></h1>

      <p class="hero__subtitle"><%= subtitle %></p>

      <p class="hero__desc"><%= desc %></p>

      <div class="hero__actions">
        <a href="<%= ctaUrl %>" class="btn btn--primary"><%= ctaText %> →</a>
        <a href="/blog?tag=recipe" class="btn btn--ghost">
          <span class="hero__play">▶</span> Смотреть рецепты
        </a>
      </div>
    </div>

    <div class="hero__stamp handwritten">
      Возьмите<br>на заметку
      <span class="hero__stamp-heart">♡</span>
    </div>

    <div class="hero__badge">
      <span class="hero__badge-top">КОЛЛАГЕН</span>
      <span class="hero__badge-leaf">🌿</span>
      <span class="hero__badge-bottom">для красоты жизни</span>
    </div>
  </div>

  <%- include('benefits') %>
</section>
