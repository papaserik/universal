<%
  var cb = (typeof contactBanner !== 'undefined' && contactBanner) ? contactBanner : null;
  var cbImg = cb && cb.imageUrl ? cb.imageUrl : null;
  var cbStyle = cbImg ? "background-image: url('" + cbImg + "');" : "";
%>
<section class="contact-section" style="<%- cbStyle %>">
  <div class="contact-section__overlay"></div>

  <div class="container contact-section__inner">

    <div class="contact-section__info">
      <h2 class="contact-section__title">Контакты</h2>
      <p class="contact-section__lead">
        Будем рады вашему сообщению! Ответим на все вопросы и поможем с выбором.
      </p>

      <ul class="contact-list">
        <li class="contact-list__item">
          <div class="contact-list__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="5" width="18" height="14" rx="2"/>
              <path d="M3 7l9 6 9-6"/>
            </svg>
          </div>
          <a href="mailto:hello@pulsun.ru">hello@pulsun.ru</a>
        </li>

        <li class="contact-list__item">
          <div class="contact-list__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
          </div>
          <div>
            <a href="tel:+70000000000">+7 (000) 000-00-00</a>
            <small>Пн–Пт с 9:00 до 18:00</small>
          </div>
        </li>

        <li class="contact-list__item">
          <div class="contact-list__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
          </div>
          <span>Санкт-Петербург</span>
        </li>
      </ul>
    </div>

    <div class="contact-section__form-wrap">
      <div class="contact-form">
        <h3 class="contact-form__title">Напишите нам</h3>

        <form method="post" action="/contact" class="contact-form__form">
          <input type="text" name="name" placeholder="Ваше имя" required class="contact-form__input">
          <input type="text" name="contact" placeholder="Email или телефон" required class="contact-form__input">
          <textarea name="message" placeholder="Ваше сообщение" required class="contact-form__textarea"></textarea>
          <button type="submit" class="contact-form__submit">Отправить <span aria-hidden="true">→</span></button>
        </form>
      </div>
    </div>

  </div>

  <div class="contact-section__decor handwritten">
    Вдохновляет<br>на вкусную<br>и здоровую жизнь
    <span class="contact-section__decor-heart">♡</span>
  </div>
</section>
