<header class="c-header">
  <div class="container c-header-inner">
    <a href="/" class="c-logo">
    <% if (settings.logoImage) { %>
      <img src="<%= settings.logoImage %>" alt="<%= settings.siteName %>" class="logo-img">
    <% } else { %>
      <%= settings.logoText || settings.siteName %>
    <% } %>
  </a>

    <div class="c-search" data-search>
      <form method="get" action="/search" autocomplete="off" style="display:flex;flex:1">
        <input type="text" name="q" class="js-search-input" placeholder="Поиск…"
               value="<%= (req.query && req.query.q) || '' %>" data-suggest-url="/api/search/suggest">
        <button type="submit" aria-label="Найти">→</button>
        <div class="search-suggest" data-suggest-box hidden></div>
      </form>
    </div>

    <nav class="c-nav">
      <a href="/catalog">Каталог</a>
      <a href="/blog">Блог</a>
      <a href="/contacts">Контакты</a>
      <a href="/cart" class="c-cart cart-link">🛒 <span class="js-cart-count"><%= cartCount %></span></a>
      <% if (user) { %>
        <% if (user.role !== 'USER') { %><a href="/admin">Админка</a><% } %>
        <a href="/logout">Выйти</a>
      <% } else { %>
        <a href="/login">Войти</a>
      <% } %>
    </nav>
  </div>
</header>
