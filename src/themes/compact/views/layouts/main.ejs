<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= meta.title %></title>
<meta name="description" content="<%= meta.description %>">
<meta name="keywords" content="<%= meta.keywords %>">
<link rel="canonical" href="<%= meta.canonical %>">
<% if (settings.favicon) { %><link rel="icon" href="<%= settings.favicon %>"><% } %>
<link rel="stylesheet" href="<%= asset('/css/base.css') %>">
<link rel="stylesheet" href="/theme/compact/assets/style.css">
<% jsonLd.forEach(o => { %><script type="application/ld+json"><%- JSON.stringify(o) %></script><% }) %>
<% if (settings.gaId) { %>
<script async src="https://www.googletagmanager.com/gtag/js?id=<%= settings.gaId %>"></script>
<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','<%= settings.gaId %>');</script>
<% } %>
<% if (settings.metrikaId) { %>
<script>(function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};m[i].l=1*new Date();k=e.createElement(t);a=e.getElementsByTagName(t)[0];k.async=1;k.src=r;a.parentNode.insertBefore(k,a)})(window,document,"script","https://mc.yandex.ru/metrika/tag.js","ym");ym(<%= settings.metrikaId %>, "init", {clickmap:true,trackLinks:true,accurateTrackBounce:true});</script>
<% } %>
<%- settings.customHead || '' %>
  <meta name="theme-color" content="#0f172a">
  <link rel="manifest" href="/modules/pwa/modules/pwa/manifest.json">
  <link rel="apple-touch-icon" sizes="180x180" href="/modules/pwa/modules/pwa/icons/apple-touch-icon.png">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Universal Shop">
  <meta name="mobile-web-app-capable" content="yes">
  <link rel="icon" type="image/png" sizes="32x32" href="/modules/pwa/modules/pwa/icons/favicon-32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/modules/pwa/modules/pwa/icons/favicon-16.png">
</head>
<body class="theme-compact">
<%- include('../partials/header') %>
<main class="container"><%- body %></main>
<%- include('../partials/footer') %>
<%- include('../partials/cookie') %>
<script src="<%= asset('/js/base.js') %>"></script>
<script src="<%= asset('/modules/favorites/favorites.js') %>"></script>
<script src="<%= asset('/js/search-suggest.js') %>"></script>
<%- settings.customBody || '' %>
<script src="<%= asset('/js/info-tips.js') %>"></script>
<% if (moduleEnabled('pwa')) { %><script src="<%= asset('/modules/pwa/pwa.js') %>"></script><% } %>
<% if (moduleEnabled('pwa_push')) { %><script src="<%= asset('/modules/push/push.js') %>"></script><% } %>
</body>
</html>
