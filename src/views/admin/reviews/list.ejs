<div class="admin-header">
  <h1>💬 Отзывы</h1>
</div>

<p class="admin-hint">
  Отзывы, отправленные покупателями, требуют модерации. Одобренные показываются на странице товара.
</p>

<div class="sales-stats" style="grid-template-columns:repeat(auto-fit,minmax(180px,1fr))">
  <a href="?filter=pending" class="sales-stat" style="text-decoration:none;color:inherit;<%= filter === 'pending' ? 'border-color:#f59e0b' : '' %>">
    <div class="sales-stat-label">На модерации</div>
    <div class="sales-stat-value"><%= counts.pending %></div>
  </a>
  <a href="?filter=approved" class="sales-stat" style="text-decoration:none;color:inherit;<%= filter === 'approved' ? 'border-color:#16a34a' : '' %>">
    <div class="sales-stat-label">Одобрено</div>
    <div class="sales-stat-value"><%= counts.approved %></div>
  </a>
  <a href="?filter=all" class="sales-stat" style="text-decoration:none;color:inherit;<%= filter === 'all' ? 'border-color:#0f172a' : '' %>">
    <div class="sales-stat-label">Всего</div>
    <div class="sales-stat-value"><%= counts.total %></div>
  </a>
</div>

<% if (!items.length) { %>
  <p style="text-align:center;color:#9ca3af;padding:40px;background:#fff;border-radius:10px;border:1px solid #e5e7eb">
    Отзывов нет
  </p>
<% } else { %>
  <div style="display:flex;flex-direction:column;gap:14px">
    <% items.forEach(r => { %>
      <div class="review-admin-card <%= r.approved ? 'approved' : 'pending' %>">
        <div class="review-admin-header">
          <div>
            <strong><%= r.name %></strong>
            <% if (r.userId && r.orderId) { %><span class="review-verified">✓ Купил</span><% } %>
            <div class="review-admin-meta">
              <%= r.createdAt.toLocaleString('ru-RU') %>
              <% if (r.email) { %> · <%= r.email %><% } %>
            </div>
          </div>
          <div style="color:#f59e0b;font-size:18px;letter-spacing:2px">
            <%= '★'.repeat(r.rating) %><%= '☆'.repeat(5 - r.rating) %>
          </div>
        </div>

        <p class="review-admin-text"><%= r.text %></p>

        <% if (r.product) { %>
          <p class="review-admin-product">
            Товар: <a href="/product/<%= r.product.slug %>" target="_blank"><%= r.product.name %></a>
          </p>
        <% } %>

        <div class="review-admin-actions">
          <% if (!r.approved) { %>
            <form method="post" action="/admin/reviews/<%= r.id %>/approve">
              <button class="btn btn-sm" style="background:#16a34a">✓ Одобрить</button>
            </form>
          <% } else { %>
            <form method="post" action="/admin/reviews/<%= r.id %>/reject">
              <button class="btn btn-sm btn-muted">✗ Снять с публикации</button>
            </form>
          <% } %>
          <form method="post" action="/admin/reviews/<%= r.id %>/delete" onsubmit="return confirm('Удалить отзыв?')">
            <button class="btn btn-sm btn-danger">Удалить</button>
          </form>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>
