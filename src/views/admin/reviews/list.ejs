<div class="admin-header">
  <h1>💬 Отзывы</h1>
</div>
<p class="admin-hint">
  Отзывы, отправленные покупателями, требуют модерации. Одобренные показываются на странице товара.
</p>

<div class="sales-stats" style="grid-template-columns:repeat(auto-fit,minmax(180px,1fr))">
  <a href="?filter=pending" class="sales-stat" style="text-decoration:none;color:inherit;<%= filter === 'pending' ? 'border-color:#f59e0b' : '' %>">
    <div class="sales-stat-label">На модерации</div>
    <div class="sales-stat-value"><%= counts.pending %></div>
  </a>
  <a href="?filter=approved" class="sales-stat" style="text-decoration:none;color:inherit;<%= filter === 'approved' ? 'border-color:#16a34a' : '' %>">
    <div class="sales-stat-label">Одобрено</div>
    <div class="sales-stat-value"><%= counts.approved %></div>
  </a>
  <a href="?filter=all" class="sales-stat" style="text-decoration:none;color:inherit;<%= filter === 'all' ? 'border-color:#0f172a' : '' %>">
    <div class="sales-stat-label">Всего</div>
    <div class="sales-stat-value"><%= counts.total %></div>
  </a>
</div>

<div class="admin-table-wrap">
  <table class="admin-table">
    <thead>
      <tr>
        <th style="width:60px;text-align:center">Оценка</th>
        <th style="width:200px">Автор</th>
        <th>Текст отзыва</th>
        <th style="width:200px">Товар</th>
        <th style="width:150px">Дата</th>
        <th style="width:120px;text-align:center">Статус</th>
        <th style="width:220px;text-align:right">Действия</th>
      </tr>
    </thead>
    <tbody>
      <% items.forEach(r => { %>
        <tr>
          <td style="text-align:center;color:#f59e0b;font-size:14px;letter-spacing:1px;white-space:nowrap">
            <%= '★'.repeat(r.rating) %><%= '☆'.repeat(5 - r.rating) %>
          </td>
          <td>
            <div class="cell-title"><%= r.name %></div>
            <% if (r.email) { %><div class="cell-sub"><%= r.email %></div><% } %>
            <% if (r.userId && r.orderId) { %><div class="cell-sub" style="color:#16a34a">✓ Покупал(а)</div><% } %>
          </td>
          <td>
            <div class="review-text-cell"><%= r.text %></div>
          </td>
          <td>
            <% if (r.product) { %>
              <a href="/product/<%= r.product.slug %>" target="_blank" style="color:#1976d2;text-decoration:none;font-size:13.5px">
                <%= r.product.name %> ↗
              </a>
            <% } else { %>
              <em style="color:#9ca3af">удалён</em>
            <% } %>
          </td>
          <td><%= r.createdAt.toLocaleString('ru-RU') %></td>
          <td style="text-align:center">
            <% if (r.approved) { %><span class="badge badge-paid">✓ Одобрен</span>
            <% } else { %><span class="badge badge-shipped">Ожидает</span><% } %>
          </td>
          <td class="cell-actions">
            <% if (!r.approved) { %>
              <form method="post" action="/admin/reviews/<%= r.id %>/approve" class="inline-form">
                <button class="btn btn-sm" style="background:#16a34a" title="Одобрить">✓</button>
              </form>
            <% } else { %>
              <form method="post" action="/admin/reviews/<%= r.id %>/reject" class="inline-form">
                <button class="btn btn-sm btn-muted" title="Снять с публикации">✗</button>
              </form>
            <% } %>
            <form method="post" action="/admin/reviews/<%= r.id %>/delete" onsubmit="return confirm('Удалить отзыв?')" class="inline-form">
              <button class="btn btn-sm btn-danger" title="Удалить">×</button>
            </form>
          </td>
        </tr>
      <% }) %>
      <% if (!items.length) { %>
        <tr><td colspan="7" style="text-align:center;color:#9ca3af;padding:40px">
          <%= filter === 'pending' ? 'На модерации нет отзывов — всё чисто!' : 'Отзывов нет' %>
        </td></tr>
      <% } %>
    </tbody>
  </table>
</div>
