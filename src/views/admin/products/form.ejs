<div class="admin-header">
  <h1><%= product ? 'Редактировать товар' : 'Новый товар' %></h1>
  <a href="/admin/products" class="btn btn-sm">← К списку</a>
</div>

<form method="post" action="<%= product ? '/admin/products/' + product.id : '/admin/products' %>" class="admin-form" id="product-form">
  <div class="form-row">
    <label class="full">Название <input type="text" name="name" value="<%= product ? product.name : '' %>" required></label>
  </div>

  <div class="form-row">
    <label>Slug (URL)
      <input type="text" name="slug" value="<%= product ? product.slug : '' %>" placeholder="оставьте пустым — сгенерируется">
    </label>
    <label>SKU <input type="text" name="sku" value="<%= product && product.sku ? product.sku : '' %>"></label>
  </div>

  <div class="form-row">
    <label>Цена, ₽ <input type="number" step="0.01" name="price" value="<%= product ? product.price : '' %>" required></label>
    <label>Старая цена, ₽ <input type="number" step="0.01" name="oldPrice" value="<%= product && product.oldPrice ? product.oldPrice : '' %>"></label>
    <label>Остаток <input type="number" name="stock" value="<%= product ? product.stock : 0 %>"></label>
    <label>Вес, кг <input type="number" step="0.01" name="weight" value="<%= product ? product.weight : 0.5 %>"></label>
  </div>

  <div class="form-row">
    <label>Категория
      <select name="categoryId">
        <option value="">— без категории —</option>
        <% categories.forEach(c => { %>
          <option value="<%= c.id %>" <%= product && product.categoryId === c.id ? 'selected' : '' %>><%= c.name %></option>
        <% }) %>
      </select>
    </label>
    <label>Сортировка <input type="number" name="sort" value="<%= product ? product.sort : 0 %>"></label>
    <label class="checkbox-label">
      <input type="checkbox" name="published" <%= !product || product.published ? 'checked' : '' %>>
      Опубликован
    </label>
  </div>

  <label class="full">Описание
    <textarea name="description" rows="6"><%= product ? product.description : '' %></textarea>
  </label>

  <fieldset class="full">
    <legend>Изображения</legend>
    <div class="upload-zone" id="upload-zone">
      <p>Перетащите файлы сюда или <label class="upload-label">выберите<input type="file" id="file-input" multiple accept="image/*" hidden></label></p>
    </div>

    <label>URL картинок (по одному на строку)
      <textarea name="images" id="images-textarea" rows="4" placeholder="/uploads/..."><%= product ? JSON.parse(product.images || '[]').join('\n') : '' %></textarea>
    </label>

    <details style="margin-top:8px">
      <summary>Библиотека загруженных файлов (<%= library.length %>)</summary>
      <div class="image-library">
        <% library.forEach(url => { %>
          <img src="<%= url %>" data-url="<%= url %>" title="Клик — добавить в товар">
        <% }) %>
        <% if (!library.length) { %><em>Файлов пока нет</em><% } %>
      </div>
    </details>

    <div class="image-preview" id="preview"></div>
  </fieldset>

  <% if (options.length) { %>
    <fieldset class="full">
      <legend>Опции (для фильтра)</legend>
      <% options.forEach(o => { %>
        <div class="opt-row">
          <strong><%= o.name %>:</strong>
          <% o.values.forEach(v => { %>
            <label class="checkbox-inline">
              <input type="checkbox" name="optionValues" value="<%= v.id %>"
                <%= selectedOptions.includes(v.id) ? 'checked' : '' %>>
              <%= v.value %>
            </label>
          <% }) %>
        </div>
      <% }) %>
    </fieldset>
  <% } %>


  <% if (moduleEnabled('marketplaces')) { %>
    <fieldset class="full" id="mp-fieldset">
    <legend>Маркетплейсы</legend>
    <p style="color:#6b7280;font-size:13px;margin:0 0 10px">
      Отметьте один или несколько маркетплейсов, где продаётся товар. На сайте под кнопкой «В корзину» появятся кнопки перехода.
    </p>
    <div id="mp-rows"></div>
    <button type="button" class="btn btn-sm" id="mp-add" style="margin-top:8px">+ Добавить маркетплейс</button>
    <input type="hidden" name="marketplaceLinks" id="mp-json-input">
  </fieldset>
    <% } %>

  <% if (moduleEnabled('brands')) { %>
    <fieldset class="full">
      <legend>🏢 Бренд</legend>
      <label>Бренд товара
        <select name="brandId">
          <option value="">— не указан —</option>
          <% brands.forEach(b => { %>
            <option value="<%= b.id %>" <%= product && product.brandId === b.id ? 'selected' : '' %>><%= b.name %></option>
          <% }) %>
        </select>
      </label>
    </fieldset>
    <% } %>

    <% if (moduleEnabled('tags')) { %>
    <fieldset class="full">
      <legend>🏷️ Теги</legend>
      <p style="font-size:13px;color:#6b7280;margin:0 0 10px">
        Теги показываются бейджами на карточке товара и используются для фильтрации.
      </p>
      <div class="product-tags-grid">
        <% allTags.forEach(t => { %>
          <label class="product-tag-option">
            <input type="checkbox" name="tags" value="<%= t.id %>"
                   <%= productTags.includes(t.id) ? 'checked' : '' %>>
            <span class="product-tag-badge" style="background:<%= t.color %>1a;color:<%= t.color %>">
              <%= t.name %>
            </span>
          </label>
        <% }) %>
        <% if (!allTags.length) { %>
          <p style="color:#9ca3af;font-size:13px;margin:0">
            Тегов пока нет. <a href="/admin/tags/new" target="_blank">Создать тег →</a>
          </p>
        <% } %>
      </div>
    </fieldset>
    <% } %>

    <fieldset class="full">
    <legend>SEO</legend>
    <label>SEO Title <input type="text" name="seoTitle" value="<%= product && product.seoTitle ? product.seoTitle : '' %>"></label>
    <label>SEO Description <input type="text" name="seoDesc" value="<%= product && product.seoDesc ? product.seoDesc : '' %>"></label>
    <label>SEO Keywords <input type="text" name="seoKeywords" value="<%= product && product.seoKeywords ? product.seoKeywords : '' %>"></label>
  </fieldset>

  <div class="form-actions">
    <button type="submit" class="btn">Сохранить</button>
    <% if (product) { %><a href="/product/<%= product.slug %>" target="_blank" class="btn btn-sm">↗ Открыть на сайте</a><% } %>
  </div>

<script>
(function () {
  const MP_LIST = <%- JSON.stringify(marketplaces) %>;
  const CURRENT = <%- JSON.stringify(currentMps) %>;

  const wrap = document.getElementById('mp-rows');
  const addBtn = document.getElementById('mp-add');
  const hidden = document.getElementById('mp-json-input');
  const form = document.getElementById('product-form');

  function esc(str) {
    return String(str || '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  }

  function rowHtml(slug, url) {
    const opts = MP_LIST.map(m =>
      '<option value="' + esc(m.slug) + '"' + (m.slug === slug ? ' selected' : '') + '>' + esc(m.name) + '</option>'
    ).join('');
    return ''
      + '<div class="mp-row">'
      +   '<select class="mp-slug">'
      +     '<option value="">— выберите —</option>'
      +     opts
      +   '</select>'
      +   '<input type="url" class="mp-url" placeholder="https://..." value="' + esc(url) + '">'
      +   '<button type="button" class="mp-remove" title="Удалить">×</button>'
      + '</div>';
  }

  function render() {
    if (!CURRENT.length) {
      wrap.innerHTML = '<p style="color:#9ca3af;font-size:13px">Маркетплейсы не добавлены</p>';
      return;
    }
    wrap.innerHTML = CURRENT.map(r => rowHtml(r.slug, r.url)).join('');
    wrap.querySelectorAll('.mp-row').forEach((row, i) => {
      row.querySelector('.mp-slug').addEventListener('change', e => { CURRENT[i].slug = e.target.value; });
      row.querySelector('.mp-url').addEventListener('input',  e => { CURRENT[i].url  = e.target.value; });
      row.querySelector('.mp-remove').addEventListener('click', () => { CURRENT.splice(i, 1); render(); });
    });
  }

  addBtn.addEventListener('click', () => {
    CURRENT.push({ slug: MP_LIST[0] ? MP_LIST[0].slug : '', url: '' });
    render();
  });

  if (form) {
    form.addEventListener('submit', () => {
      const clean = CURRENT.filter(x => x.slug && x.url);
      hidden.value = JSON.stringify(clean);
    });
  }

  render();
})();
</script>

</form>

<script>
(function(){
  const zone = document.getElementById('upload-zone');
  const input = document.getElementById('file-input');
  const textarea = document.getElementById('images-textarea');
  const preview = document.getElementById('preview');

  async function uploadFiles(files) {
    if (!files.length) return;
    const fd = new FormData();
    for (const f of files) fd.append('files', f);
    const res = await fetch('/admin/products/upload-images', { method: 'POST', body: fd });
    const data = await res.json();
    if (!data.ok) return alert('Ошибка загрузки');
    const existing = textarea.value.split('\n').map(s => s.trim()).filter(Boolean);
    textarea.value = existing.concat(data.urls).join('\n');
    renderPreview();
  }

  function renderPreview() {
    const urls = textarea.value.split('\n').map(s => s.trim()).filter(Boolean);
    preview.innerHTML = urls.map(u => '<img src="' + u + '">').join('');
  }

  input.addEventListener('change', e => uploadFiles(e.target.files));
  zone.addEventListener('dragover', e => { e.preventDefault(); zone.classList.add('drag'); });
  zone.addEventListener('dragleave', () => zone.classList.remove('drag'));
  zone.addEventListener('drop', e => {
    e.preventDefault(); zone.classList.remove('drag');
    uploadFiles(e.dataTransfer.files);
  });
  textarea.addEventListener('input', renderPreview);

  document.querySelectorAll('.image-library img').forEach(img => {
    img.addEventListener('click', () => {
      const url = img.dataset.url;
      const existing = textarea.value.split('\n').map(s => s.trim()).filter(Boolean);
      if (!existing.includes(url)) {
        textarea.value = existing.concat(url).join('\n');
        renderPreview();
      }
    });
  });

  renderPreview();
})();
</script>
