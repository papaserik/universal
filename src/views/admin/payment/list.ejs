<div class="admin-header">
  <h1>💳 Способы оплаты</h1>
  <a href="/admin/payment/new" class="btn">+ Добавить способ</a>
</div>
<p class="admin-hint">
  Активные способы показываются покупателю на оформлении заказа.
</p>

<div class="admin-table-wrap">
  <table class="admin-table" data-sortable="payment">
    <thead>
      <tr>
        <th style="width:36px"></th>
        <th style="width:60px;text-align:center">Иконка</th>
        <th>Название</th>
        <th style="width:140px">Тип</th>
        <th style="width:160px">Код</th>
        <th style="width:110px;text-align:center">Статус</th>
        <th style="width:180px;text-align:right">Действия</th>
      </tr>
    </thead>
    <tbody>
      <% methods.forEach(m => { %>
        <tr data-id="<%= m.id %>">
          <td class="drag-handle-cell"><span class="drag-handle" title="Перетащите">⋮⋮</span></td>
          <td style="font-size:22px;text-align:center"><%= m.icon || '—' %></td>
          <td>
            <div class="cell-title"><%= m.name %></div>
            <% if (m.description) { %><div class="cell-sub"><%= m.description %></div><% } %>
          </td>
          <td><span class="badge"><%= m.type %></span></td>
          <td><code class="cell-code"><%= m.code %></code></td>
          <td style="text-align:center">
            <form method="post" action="/admin/payment/<%= m.id %>/toggle" class="inline-form">
              <button class="btn btn-sm <%= m.active ? '' : 'btn-muted' %>"><%= m.active ? '✓ Активен' : '✗ Отключён' %></button>
            </form>
          </td>
          <td class="cell-actions">
            <a href="/admin/payment/<%= m.id %>" class="btn btn-sm">Изменить</a>
            <form method="post" action="/admin/payment/<%= m.id %>/delete" onsubmit="return confirm('Удалить способ оплаты?')" class="inline-form">
              <button class="btn btn-sm btn-danger" title="Удалить">×</button>
            </form>
          </td>
        </tr>
      <% }) %>
      <% if (!methods.length) { %>
        <tr><td colspan="7" style="text-align:center;color:#9ca3af;padding:40px">Способов оплаты нет</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
