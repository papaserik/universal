<div class="admin-header">
  <h1>📝 Посты блога</h1>
  <a href="/admin/blog/new" class="btn">+ Новый пост</a>
</div>

<div class="admin-table-wrap">
  <table class="admin-table">
    <thead>
      <tr>
        <th style="width:50px">ID</th>
        <th>Заголовок</th>
        <th style="width:200px">Slug</th>
        <th style="width:150px">Автор</th>
        <th style="width:180px">Категория</th>
        <th style="width:90px;text-align:center">Просм.</th>
        <th style="width:120px;text-align:center">Опубл.</th>
        <th style="width:120px">Дата</th>
        <th style="width:180px;text-align:right">Действия</th>
      </tr>
    </thead>
    <tbody>
      <% posts.forEach(p => { %>
        <tr>
          <td><%= p.id %></td>
          <td>
            <div class="cell-title"><%= p.title %></div>
            <% if (p.excerpt) { %><div class="cell-sub"><%= p.excerpt.slice(0, 80) %><%= p.excerpt.length > 80 ? '…' : '' %></div><% } %>
          </td>
          <td><code class="cell-code">/blog/<%= p.slug %></code></td>
          <td><%= p.author ? (p.author.name || p.author.email) : '—' %></td>
          <td>
            <% if (p.blogCategory) { %>
              <span class="badge"><%= p.blogCategory.name %></span>
            <% } else { %>
              <em style="color:#9ca3af">—</em>
            <% } %>
          </td>
          <td style="text-align:center"><%= p.views %></td>
          <td style="text-align:center">
            <% if (p.published) { %><span class="badge badge-paid">✓ Да</span>
            <% } else { %><span class="badge">Нет</span><% } %>
          </td>
          <td><%= p.createdAt.toLocaleDateString('ru-RU') %></td>
          <td class="cell-actions">
            <a href="/blog/<%= p.slug %>" target="_blank" class="btn btn-sm btn-muted" title="Открыть на сайте">↗</a>
            <a href="/admin/blog/<%= p.id %>" class="btn btn-sm">Изменить</a>
            <form method="post" action="/admin/blog/<%= p.id %>/delete" onsubmit="return confirm('Удалить пост?')" class="inline-form">
              <button class="btn btn-sm btn-danger" title="Удалить">×</button>
            </form>
          </td>
        </tr>
      <% }) %>
      <% if (!posts.length) { %>
        <tr><td colspan="9" style="text-align:center;color:#9ca3af;padding:40px">Постов нет</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
