<script src="https://cdn.jsdelivr.net/npm/tinymce@7.4.1/tinymce.min.js" referrerpolicy="origin"></script>
<script>
tinymce.init({
  selector: '<%= selector || "textarea[name=content]" %>',
  language: 'ru',
  language_url: 'https://cdn.jsdelivr.net/npm/tinymce-i18n@24.10.22/langs7/ru.js',
  height: 480,
  menubar: true,
  plugins: 'lists link image table code fullscreen preview media codesample autoresize',
  toolbar: 'undo redo | styles h1 h2 h3 | bold italic underline | bullist numlist | link image media table | blockquote codesample | alignleft aligncenter alignright | code fullscreen preview',
  branding: false,
  promotion: false,
  convert_urls: false,
  image_title: true,
  automatic_uploads: false,
  content_style: 'body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; font-size: 16px; line-height: 1.6; }'
});
</script>
