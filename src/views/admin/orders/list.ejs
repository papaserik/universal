<div class="admin-header">
  <h1>Заказы</h1>
  <div style="display:flex;gap:8px">
    <a href="/admin/orders/export/csv<%= status ? '?status=' + status : '' %><%= source ? (status ? '&' : '?') + 'source=' + source : '' %>" class="btn btn-sm">📥 Экспорт CSV</a>
  </div>
</div>

<%# ─── Статистика ─── %>
<div class="sales-stats" style="grid-template-columns:repeat(auto-fit,minmax(180px,1fr))">
  <div class="sales-stat">
    <div class="sales-stat-label">Заказов в выборке</div>
    <div class="sales-stat-value"><%= stats.total %></div>
  </div>
  <div class="sales-stat">
    <div class="sales-stat-label">Сумма заказов</div>
    <div class="sales-stat-value"><%= Math.round(stats.totalSum).toLocaleString('ru-RU') %> ₽</div>
  </div>
  <div class="sales-stat" style="<%= stats.totalCommission > 0 ? 'background:#fef2f2;border-color:#fecaca' : '' %>">
    <div class="sales-stat-label">Комиссия МП</div>
    <div class="sales-stat-value" style="<%= stats.totalCommission > 0 ? 'color:#dc2626' : '' %>">
      <%= Math.round(stats.totalCommission).toLocaleString('ru-RU') %> ₽
    </div>
  </div>
  <div class="sales-stat" style="background:#f0fdf4;border-color:#bbf7d0">
    <div class="sales-stat-label">Чистая прибыль</div>
    <div class="sales-stat-value" style="color:#16a34a">
      <%= Math.round(stats.totalProfit).toLocaleString('ru-RU') %> ₽
    </div>
  </div>
</div>

<%# ─── Фильтры ─── %>
<form method="get" class="admin-search">
  <select name="status" onchange="this.form.submit()" style="padding:10px 14px;border:1px solid #d1d5db;border-radius:8px;font:inherit;font-size:14px;background:#fff;max-width:220px">
    <option value="">Все статусы</option>
    <% statuses.forEach(s => { %>
      <option value="<%= s.code %>" <%= status === s.code ? 'selected' : '' %>>
        <%= s.icon ? s.icon + ' ' : '' %><%= s.name %>
      </option>
    <% }) %>
  </select>

  <select name="source" onchange="this.form.submit()" style="padding:10px 14px;border:1px solid #d1d5db;border-radius:8px;font:inherit;font-size:14px;background:#fff;max-width:240px">
    <option value="">Все источники</option>
    <option value="own" <%= source === 'own' ? 'selected' : '' %>>🏠 Свой магазин</option>
    <% integrations.forEach(i => { %>
      <option value="<%= i.slug %>" <%= source === i.slug ? 'selected' : '' %>>
        <%= i.slug === 'ozon' ? '🔵' : i.slug === 'wildberries' ? '🟣' : i.slug === 'yandex' ? '🔴' : i.slug === 'sbermarket' ? '🟢' : '🏪' %>
        <%= i.name %>
      </option>
    <% }) %>
  </select>
</form>

<div class="admin-table-wrap">
  <table class="admin-table">
    <thead>
      <tr>
        <th style="width:50px">ID</th>
        <th>Номер</th>
        <th style="width:150px;text-align:center">
          Источник
          <i class="info-tip" data-tip="Откуда пришёл заказ: 🏠 Свой магазин или один из маркетплейсов. На статистику и прибыль это влияет: с маркетплейса комиссия удерживается, со своего сайта — вся сумма ваша."></i>
        </th>
        <th style="width:170px">Дата</th>
        <th>Клиент</th>
        <th style="width:120px;text-align:right">Сумма</th>
        <th style="width:130px;text-align:right">
          Комиссия
          <i class="info-tip info-tip-left" data-tip="Комиссия маркетплейса за этот заказ. Считается по ставкам: товар → категория. Если API маркетплейса подключено — точная комиссия подтянется при синхронизации (⏳ API)."></i>
        </th>
        <th style="width:130px;text-align:right">
          Прибыль
          <i class="info-tip info-tip-left" data-tip="Сумма заказа минус комиссия маркетплейса. Для заказов со своего сайта — равна сумме (комиссия 0%). Знак «~» — прогнозная прибыль, ожидает точных данных от API."></i>
        </th>
        <th style="width:150px;text-align:center">Статус</th>
        <th style="width:120px;text-align:right">Действия</th>
      </tr>
    </thead>
    <tbody>
      <% orders.forEach(o => {
           const st = statusMap[o.status] || { name: o.status, color: '#6b7280', icon: '' };
           const src = o.source || 'own';
           const srcName = src === 'own' ? 'Свой' : (integrations.find(i => i.slug === src)?.name || src);
           const srcIcon = src === 'own' ? '🏠' : src === 'ozon' ? '🔵' : src === 'wildberries' ? '🟣' : src === 'yandex' ? '🔴' : src === 'sbermarket' ? '🟢' : '🏪';
           const srcColor = src === 'own' ? '#16a34a' : src === 'ozon' ? '#005bff' : src === 'wildberries' ? '#cb11ab' : src === 'yandex' ? '#fc3f1d' : src === 'sbermarket' ? '#21a038' : '#6b7280';
      %>
        <tr>
          <td><%= o.id %></td>
          <td>
            <div class="cell-title">
              <%= o.number %>
              <% if (o.isGift) { %><span class="gift-badge" title="Заказ в подарок">🎁</span><% } %>
            </div>
            <% if (o.externalNumber) { %>
              <div class="cell-sub" style="font-family:monospace;font-size:11px">
                МП: <%= o.externalNumber %>
              </div>
            <% } %>
          </td>
          <td style="text-align:center">
            <span class="source-pill" style="background:<%= srcColor %>1a;color:<%= srcColor %>">
              <%= srcIcon %> <%= srcName %>
            </span>
          </td>
          <td><%= o.createdAt.toLocaleString('ru-RU') %></td>
          <td>
            <div class="cell-title"><%= o.name %></div>
            <div class="cell-sub"><%= o.email %></div>
          </td>
          <td style="text-align:right"><%= o.total.toLocaleString('ru-RU') %> ₽</td>
          <td style="text-align:right">
            <% if (o.commissionStatus === 'api_pending') { %>
              <span class="commission-pending" title="Точная комиссия придёт после синхронизации с API">⏳ API</span>
            <% } else if (o.commissionAmount > 0) { %>
              <span style="color:#dc2626">−<%= Math.round(o.commissionAmount).toLocaleString('ru-RU') %> ₽</span>
            <% } else { %>
              <span style="color:#9ca3af">—</span>
            <% } %>
          </td>
          <td style="text-align:right;font-weight:700">
            <% if (o.commissionStatus === 'api_pending') { %>
              <span style="color:#9ca3af">~<%= Math.round(o.netProfit || o.total).toLocaleString('ru-RU') %> ₽</span>
            <% } else { %>
              <span style="color:#16a34a"><%= Math.round(o.netProfit || o.total).toLocaleString('ru-RU') %> ₽</span>
            <% } %>
          </td>
          <td style="text-align:center">
            <span class="status-pill" style="background:<%= st.color %>1a;color:<%= st.color %>">
              <%= st.icon || '' %> <%= st.name %>
            </span>
          </td>
          <td class="cell-actions">
            <a href="/admin/orders/<%= o.id %>" class="btn btn-sm">Открыть</a>
          </td>
        </tr>
      <% }) %>
      <% if (!orders.length) { %>
        <tr><td colspan="10" style="text-align:center;color:#9ca3af;padding:40px">Заказов нет</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
