<div class="admin-header">
  <h1>Заказы</h1>
  <a href="/admin/orders/export/csv<%= status ? '?status=' + status : '' %>" class="btn btn-sm">📥 Экспорт CSV</a>
</div>

<form method="get" class="admin-search">
  <select name="status" onchange="this.form.submit()" style="padding:10px 14px;border:1px solid #d1d5db;border-radius:8px;font:inherit;font-size:14px;background:#fff;max-width:240px">
    <option value="">Все статусы</option>
    <% statuses.forEach(s => { %>
      <option value="<%= s.code %>" <%= status === s.code ? 'selected' : '' %>>
        <%= s.icon ? s.icon + ' ' : '' %><%= s.name %>
      </option>
    <% }) %>
  </select>
</form>

<div class="admin-table-wrap">
  <table class="admin-table">
    <thead>
      <tr>
        <th style="width:50px">ID</th>
        <th>Номер</th>
        <th style="width:170px">Дата</th>
        <th>Клиент</th>
        <th style="width:90px;text-align:center">Позиций</th>
        <th style="width:120px">Сумма</th>
        <th style="width:150px;text-align:center">Статус</th>
        <th style="width:140px;text-align:right">Действия</th>
      </tr>
    </thead>
    <tbody>
      <% orders.forEach(o => {
           const st = statusMap[o.status] || { name: o.status, color: '#6b7280', icon: '' };
      %>
        <tr>
          <td><%= o.id %></td>
          <td>
            <div class="cell-title">
              <%= o.number %>
              <% if (o.isGift) { %><span class="gift-badge" title="Заказ в подарок">🎁</span><% } %>
            </div>
          </td>
          <td><%= o.createdAt.toLocaleString('ru-RU') %></td>
          <td>
            <div class="cell-title"><%= o.name %></div>
            <div class="cell-sub"><%= o.email %></div>
          </td>
          <td style="text-align:center"><%= o.items.length %></td>
          <td><div class="cell-price"><%= o.total.toLocaleString('ru-RU') %> ₽</div></td>
          <td style="text-align:center">
            <span class="status-pill" style="background:<%= st.color %>1a;color:<%= st.color %>">
              <%= st.icon || '' %> <%= st.name %>
            </span>
          </td>
          <td class="cell-actions">
            <a href="/admin/orders/<%= o.id %>" class="btn btn-sm">Открыть</a>
          </td>
        </tr>
      <% }) %>
      <% if (!orders.length) { %>
        <tr><td colspan="8" style="text-align:center;color:#9ca3af;padding:40px">Заказов нет</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
