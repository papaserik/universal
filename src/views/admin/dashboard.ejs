<div class="admin-header">
  <h1>Дашборд</h1>
  <div style="color:#6b7280;font-size:14px">Привет, <strong><%= adminUser.name || adminUser.email %></strong></div>
</div>

<%# ═══════════ Основные метрики ═══════════ %>
<div class="stat-grid">
  <div class="stat-card"><span class="stat-num"><%= stats.products %></span><span>Товаров</span></div>
  <div class="stat-card"><span class="stat-num"><%= stats.orders %></span><span>Заказов всего</span></div>
  <div class="stat-card" style="<%= stats.newOrders > 0 ? 'border-color:#3b82f6' : '' %>">
    <span class="stat-num"><%= stats.newOrders %></span><span>Новых (требуют внимания)</span>
  </div>
  <div class="stat-card"><span class="stat-num"><%= stats.users %></span><span>Пользователей</span></div>
  <div class="stat-card"><span class="stat-num"><%= stats.posts %></span><span>Постов</span></div>
  <div class="stat-card"><span class="stat-num"><%= stats.pages %></span><span>Страниц</span></div>
</div>

<%# ═══════════ Финансовые метрики ═══════════ %>
<div class="finance-grid">
  <div class="finance-card">
    <div class="finance-label">Выручка (без отменённых)</div>
    <div class="finance-value"><%= Math.round(stats.revenue).toLocaleString('ru-RU') %> ₽</div>
    <div class="finance-sub">Все заказы за всё время</div>
  </div>

  <div class="finance-card finance-card-warn">
    <div class="finance-label">
      Комиссия маркетплейсов
      <i class="info-tip" data-tip="Сколько маркетплейсы удерживают с ваших продаж. Точная комиссия подтягивается при синхронизации заказов через API. Ручная — по ставкам в разделе «Комиссии МП»."></i>
    </div>
    <div class="finance-value"><%= Math.round(stats.totalCommission).toLocaleString('ru-RU') %> ₽</div>
    <div class="finance-sub">
      <%
        const commPercent = stats.revenue > 0 ? (stats.totalCommission / stats.revenue * 100) : 0;
      %>
      <%= commPercent.toFixed(1) %> % от выручки
    </div>
  </div>

  <div class="finance-card finance-card-success">
    <div class="finance-label">
      Чистая прибыль
      <i class="info-tip info-tip-left" data-tip="Выручка минус комиссии маркетплейсов. Для заказов со своего сайта комиссия 0% — вся сумма ваша. Знак «~» у отдельных заказов — прогнозная прибыль, ожидает точных данных от API."></i>
    </div>
    <div class="finance-value"><%= Math.round(stats.totalProfit).toLocaleString('ru-RU') %> ₽</div>
    <div class="finance-sub">
      <%
        const profitPercent = stats.revenue > 0 ? (stats.totalProfit / stats.revenue * 100) : 0;
      %>
      <%= profitPercent.toFixed(1) %> % маржа
    </div>
  </div>

  <a href="/admin/sales/abandoned" class="finance-card <%= stats.abandonedCount > 0 ? 'finance-card-warn' : '' %>" style="text-decoration:none;color:inherit">
    <div class="finance-label">🛒 Брошенных корзин</div>
    <div class="finance-value"><%= stats.abandonedCount %></div>
    <div class="finance-sub">Требуют внимания</div>
  </a>
</div>

<%# ═══════════ Заказы по источникам ═══════════ %>
<% if (sourceList.length > 0) { %>
  <section class="sales-block">
    <header style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:16px;gap:12px">
      <h2 style="margin:0">
        Заказы по источникам
        <i class="info-tip" data-tip="Каждый заказ имеет источник: 🏠 свой магазин или маркетплейс. Это влияет на комиссию и чистую прибыль. Заказ со своего сайта = вся сумма ваша. Заказ с МП = минус комиссия."></i>
      </h2>
      <a href="/admin/orders" class="cabinet-link" style="font-size:13.5px;color:#1976d2;text-decoration:none">Все заказы →</a>
    </header>

    <div class="sources-grid">
      <% sourceList.forEach(s => { %>
        <a href="/admin/orders?source=<%= s.slug %>" class="source-card" style="--source-color: <%= s.color %>">
          <div class="source-card-head">
            <span class="source-card-icon"><%= s.icon %></span>
            <span class="source-card-name"><%= s.name %></span>
          </div>
          <div class="source-card-num"><%= s.count %></div>
          <div class="source-card-revenue"><%= Math.round(s.revenue).toLocaleString('ru-RU') %> ₽</div>
          <% if (s.commission > 0) { %>
            <div class="source-card-commission">
              −<%= Math.round(s.commission).toLocaleString('ru-RU') %> ₽ комиссия
            </div>
          <% } %>
          <div class="source-card-profit">
            <span style="color:#16a34a">✓ <%= Math.round(s.profit).toLocaleString('ru-RU') %> ₽</span>
          </div>
        </a>
      <% }) %>
    </div>
  </section>
<% } %>

<%# ═══════════ Заказы по статусам ═══════════ %>
<section class="sales-block">
  <h2>Заказы по статусам (30 дней)</h2>
  <div class="status-counters">
    <% statuses.forEach(s => { %>
      <a href="/admin/orders?status=<%= s.code %>" class="status-counter">
        <span class="status-counter-icon" style="background:<%= s.color %>1a;color:<%= s.color %>">
          <%= s.icon || '●' %>
        </span>
        <span class="status-counter-body">
          <span class="status-counter-name"><%= s.name %></span>
          <span class="status-counter-count"><%= statusCounts[s.code] || 0 %></span>
        </span>
      </a>
    <% }) %>
  </div>
</section>

<%# ═══════════ Последние 10 заказов ═══════════ %>
<section class="sales-block">
  <h2>Последние 10 заказов</h2>
  <div class="admin-table-wrap">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Номер</th>
          <th style="width:130px;text-align:center">Источник</th>
          <th style="width:160px">Дата</th>
          <th>Клиент</th>
          <th style="width:90px;text-align:center">Позиций</th>
          <th style="width:130px;text-align:right">Сумма</th>
          <th style="width:130px;text-align:right">Прибыль</th>
          <th style="width:140px;text-align:center">Статус</th>
          <th style="width:120px;text-align:right">Действия</th>
        </tr>
      </thead>
      <tbody>
        <% recent.forEach(o => {
             const st = statusMap[o.status] || { name: o.status, color: '#6b7280', icon: '' };
             const src = o.source || 'own';
             const srcInfo = src === 'own'
               ? { name: 'Свой', icon: '🏠', color: '#16a34a' }
               : (integrationMap[src] || { name: src, icon: '🏪', color: '#6b7280' });
        %>
          <tr>
            <td>
              <div class="cell-title">
                <%= o.number %>
                <% if (o.isGift) { %><span class="gift-badge" title="Заказ в подарок">🎁</span><% } %>
              </div>
            </td>
            <td style="text-align:center">
              <span class="source-pill" style="background:<%= srcInfo.color %>1a;color:<%= srcInfo.color %>">
                <%= srcInfo.icon %> <%= srcInfo.name %>
              </span>
            </td>
            <td><%= o.createdAt.toLocaleString('ru-RU') %></td>
            <td>
              <div class="cell-title"><%= o.name %></div>
              <div class="cell-sub"><%= o.email %></div>
            </td>
            <td style="text-align:center"><%= o.items.length %></td>
            <td style="text-align:right"><%= o.total.toLocaleString('ru-RU') %> ₽</td>
            <td style="text-align:right;font-weight:700">
              <% if (o.commissionStatus === 'api_pending') { %>
                <span style="color:#9ca3af" title="Ожидает точной комиссии от API">~<%= Math.round(o.netProfit || o.total).toLocaleString('ru-RU') %> ₽</span>
              <% } else { %>
                <span style="color:#16a34a"><%= Math.round(o.netProfit || o.total).toLocaleString('ru-RU') %> ₽</span>
              <% } %>
            </td>
            <td style="text-align:center">
              <span class="status-pill" style="background:<%= st.color %>1a;color:<%= st.color %>">
                <%= st.icon || '' %> <%= st.name %>
              </span>
            </td>
            <td class="cell-actions">
              <a href="/admin/orders/<%= o.id %>" class="btn btn-sm">Открыть</a>
            </td>
          </tr>
        <% }) %>
        <% if (!recent.length) { %>
          <tr><td colspan="9" style="text-align:center;color:#9ca3af;padding:40px">
            Заказов пока нет. Сделайте первый заказ на сайте, чтобы увидеть статистику.
          </td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>
