<div class="admin-header">
  <h1>Категории блога</h1>
  <a href="/admin/blog-categories/new" class="btn">+ Добавить категорию</a>
</div>
<p class="admin-hint">Категории группируют посты блога. Можно создавать подкатегории, выбирая родителя.</p>
<table class="admin-table" data-sortable="blogCategories">
  <thead><tr><th>ID</th><th>Название</th><th>Slug</th><th>Постов</th><th>Сортировка</th><th></th></tr></thead>
  <tbody>
    <% cats.forEach(c => { %>
      <tr data-id="<%= c.id %>">
        <td><%= c.id %></td>
        <td><%= c.name %></td>
        <td>/blog/category/<%= c.slug %></td>
        <td><%= c._count.posts %></td>
        <td><%= c.sort %></td>
        <td class="row-actions">
          <a href="/admin/blog-categories/<%= c.id %>" class="btn btn-sm">Изменить</a>
          <form method="post" action="/admin/blog-categories/<%= c.id %>/delete" onsubmit="return confirm('Удалить категорию?')">
            <button class="btn btn-sm btn-danger">×</button>
          </form>
        </td>
      </tr>
    <% }) %>
    <% if (!cats.length) { %><tr><td colspan="6">Категорий нет</td></tr><% } %>
  </tbody>
</table>
