<div class="admin-header">
  <h1>Способы доставки</h1>
  <a href="/admin/delivery/new" class="btn">+ Добавить способ</a>
</div>
<p class="admin-hint">Активные способы показываются покупателю при оформлении заказа.</p>
<table class="admin-table" data-sortable="delivery">
  <thead><tr><th style="width:40px"></th><th style="width:50px">Сорт.</th><th>Название</th><th>Тип</th><th>Стоимость</th><th>Статус</th><th></th></tr></thead>
  <tbody>
  <% methods.forEach(m => { %>
    <tr data-id="<%= m.id %>">
        <td style="font-size:20px"><%= m.icon || '—' %></td>
      <td><%= m.sort %></td>
      <td><%= m.name %><% if (m.description) { %><br><small style="color:#6b7280"><%= m.description %></small><% } %></td>
      <td><span class="badge"><%= m.type %></span></td>
      <td><% if (m.type === 'free') { %>бесплатно<% } else if (m.type === 'flat') { %><%= m.price %> ₽<% } else if (m.type === 'weight') { %><%= m.pricePerKg %> ₽/кг<% } else { %>по запросу<% } %></td>
      <td>
        <form method="post" action="/admin/delivery/<%= m.id %>/toggle" style="display:inline">
          <button class="btn btn-sm <%= m.active ? '' : 'btn-muted' %>"><%= m.active ? '✓ Активен' : '✗ Отключён' %></button>
        </form>
      </td>
      <td class="row-actions">
        <a href="/admin/delivery/<%= m.id %>" class="btn btn-sm">Изменить</a>
        <form method="post" action="/admin/delivery/<%= m.id %>/delete" onsubmit="return confirm('Удалить?')"><button class="btn btn-sm btn-danger">×</button></form>
      </td>
    </tr>
  <% }) %>
  <% if (!methods.length) { %><tr><td colspan="7">Способов доставки нет</td></tr><% } %>
  </tbody>
</table>
