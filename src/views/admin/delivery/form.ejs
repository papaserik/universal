<div class="admin-header">
  <h1><%= method ? 'Изменить способ доставки' : 'Новый способ доставки' %></h1>
  <a href="/admin/delivery" class="btn btn-sm">← К списку</a>
</div>
<form method="post" action="<%= method ? '/admin/delivery/' + method.id : '/admin/delivery' %>" class="admin-form">
  <div class="form-row">
    <label>Название для покупателя * <input type="text" name="name" value="<%= method ? method.name : '' %>" required></label>
    <label>Код (латиница) * <input type="text" name="code" value="<%= method ? method.code : '' %>" required></label>
  </div>
  <label>Описание <input type="text" name="description" value="<%= method && method.description ? method.description : '' %>"></label>
  <div class="form-row">
    <label>Тип
      <select name="type">
        <option value="free" <%= method && method.type==='free'?'selected':'' %>>Бесплатно</option>
        <option value="flat" <%= method && method.type==='flat'?'selected':'' %>>Фиксированная цена</option>
        <option value="weight" <%= method && method.type==='weight'?'selected':'' %>>По весу</option>
        <option value="manager" <%= method && method.type==='manager'?'selected':'' %>>Обсудить с менеджером</option>
      </select>
    </label>
    <label>Иконка <input type="text" name="icon" maxlength="4" value="<%= method && method.icon ? method.icon : '' %>" placeholder="🚚"></label>
  </div>
  <div class="form-row">
    <label>Стоимость, ₽ <input type="number" step="0.01" name="price" value="<%= method ? method.price : 0 %>"></label>
    <label>Цена за кг, ₽ <input type="number" step="0.01" name="pricePerKg" value="<%= method && method.pricePerKg ? method.pricePerKg : '' %>"></label>
  </div>
  <label>Бесплатно от, ₽ <input type="number" step="0.01" name="freeFrom" value="<%= method && method.freeFrom ? method.freeFrom : '' %>"></label>
  <div class="form-row">
    <label>Сортировка <input type="number" name="sort" value="<%= method ? method.sort : 0 %>"></label>
    <label class="checkbox-label" style="align-self:flex-end"><input type="checkbox" name="active" <%= !method || method.active ? 'checked' : '' %>> Активен</label>
  </div>
  <div class="form-actions"><button class="btn">Сохранить</button></div>
</form>
