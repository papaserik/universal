<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= typeof title !== 'undefined' ? title : 'Админка' %> — Universal Shop</title>
<link rel="stylesheet" href="<%= asset('/css/base.css') %>">
<link rel="stylesheet" href="<%= asset('/css/admin.css') %>">
<style id="admin-layout-v4">
  /* ===================== БАЗОВАЯ СТРУКТУРА ===================== */
  html, body { margin: 0; padding: 0; }
  * { box-sizing: border-box; }

  .admin-shell {
    display: grid;
    grid-template-columns: 240px 1fr;
    min-height: 100vh;
    background: #f4f5f7;
  }

  /* ===================== САЙДБАР (компактный) ===================== */
  .admin-side {
    background: #0f172a;
    color: #94a3b8;
    display: flex;
    flex-direction: column;
    position: sticky;
    top: 0;
    height: 100vh;
    overflow-y: auto;
    padding: 8px 0;
    font-size: 14px;
  }
  .admin-side a {
    display: block;
    padding: 8px 18px;
    color: #cbd5e1;
    text-decoration: none;
    border-radius: 0;
    transition: background .12s, color .12s;
  }
  .admin-side a:hover { background: #1e293b; color: #fff; }
  .admin-side a.active { background: #1d4ed8; color: #fff; }

  .admin-group-toggle {
    width: 100%; background: none; border: 0;
    color: #cbd5e1; padding: 8px 18px;
    text-align: left; cursor: pointer; font-size: 14px;
    display: flex; justify-content: space-between; align-items: center;
    font-family: inherit;
  }
  .admin-group-toggle:hover { background: #1e293b; color: #fff; }
  .admin-group-toggle > span:last-child { transition: transform .15s; }
  .admin-group.open .admin-group-toggle > span:last-child { transform: rotate(90deg); }

  .admin-group-items { display: none; }
  .admin-group.open .admin-group-items { display: block; }
  .admin-group-items a {
    padding-left: 34px;
    font-size: 13px;
    color: #94a3b8;
  }

  .admin-bottom {
    margin-top: auto;
    border-top: 1px solid #1e293b;
    padding-top: 6px;
  }
  .admin-bottom a { font-size: 13px; color: #64748b; }

  /* ===================== ОСНОВНАЯ ОБЛАСТЬ ===================== */
  .admin-main {
    padding: 20px 24px 32px;
    position: relative;
    min-width: 0;
  }

  .admin-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 18px;
  }
  .admin-header h1 {
    margin: 0;
    font-size: 22px;
    font-weight: 700;
    color: #0f172a;
  }
  .admin-header h2 { margin: 0; font-size: 18px; }
  .admin-user { color: #64748b; font-size: 14px; }

  /* ===================== КАРТОЧКИ МЕТРИК ===================== */
  .stat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 12px;
    margin-bottom: 24px;
  }
  .stat-card {
    background: #fff;
    padding: 12px 16px;
    border-radius: 10px;
    border: 1px solid #e5e7eb;
    border-left: 3px solid #3b82f6;
    display: flex;
    flex-direction: row;
    align-items: baseline;
    gap: 10px;
    transition: box-shadow .15s, transform .15s;
  }
  .stat-card:hover { box-shadow: 0 4px 14px rgba(0,0,0,.06); }

  /* Акцентные цвета для карточек */
  .stat-grid > .stat-card:nth-child(4n+1) { border-left-color: #3b82f6; }
  .stat-grid > .stat-card:nth-child(4n+2) { border-left-color: #10b981; }
  .stat-grid > .stat-card:nth-child(4n+3) { border-left-color: #f59e0b; }
  .stat-grid > .stat-card:nth-child(4n+0) { border-left-color: #8b5cf6; }

  /* Широкая карточка — своя цветовая логика (красный/зелёный из шаблона) */
  .stat-card-wide {
    grid-column: 1 / -1;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    border-left: 3px solid #cbd5e1;
  }

  .stat-num {
    font-size: 22px;
    font-weight: 700;
    color: #0f172a;
    line-height: 1;
  }
  .stat-card > span:last-child {
    font-size: 13px;
    color: #64748b;
  }
  .stat-card-wide .stat-num { font-size: 26px; }
  .stat-card-wide > span:last-child { font-size: 14px; }

  /* ===================== ПРОЧЕЕ ===================== */
  .admin-alert {
    padding: 10px 14px;
    border-radius: 8px;
    margin-bottom: 16px;
    background: #dcfce7; color: #166534;
  }
  .admin-footer {
    margin-top: 40px; padding-top: 16px;
    border-top: 1px solid #e5e7eb;
    color: #94a3b8; font-size: 12px;
  }
  .admin-footer a { color: #64748b; }

  /* ===================== МОБИЛЬНАЯ ВЕРСИЯ ===================== */
  .admin-burger { display: none; }
  .admin-overlay { display: none; }

  @media (max-width: 900px) {
    .admin-shell { display: block; }

    .admin-main { padding: 10px 12px 20px !important; position: relative; }

    .admin-burger {
      display: flex !important;
      position: absolute !important;
      top: 12px !important; left: 12px !important;
      width: 40px !important; height: 40px !important;
      border-radius: 10px !important;
      background: #0f172a !important; color: #fff !important;
      border: 0 !important; font-size: 18px !important;
      align-items: center !important; justify-content: center !important;
      z-index: 100 !important; cursor: pointer !important;
    }

    .admin-header {
      padding: 0 0 0 52px !important;
      margin: 0 0 14px !important;
      min-height: 40px !important;
      display: flex !important;
      align-items: center !important;
      justify-content: space-between !important;
      gap: 8px !important;
      flex-wrap: nowrap !important;
    }
    .admin-header h1 {
      font-size: 18px !important;
      line-height: 40px !important;
      margin: 0 !important;
      padding: 0 !important;
      flex: 1 1 auto !important;
    }
    .admin-header > *:last-child {
      font-size: 12px !important;
      line-height: 1 !important;
      white-space: nowrap !important;
      flex: 0 0 auto !important;
    }

    .admin-side {
      position: fixed !important;
      top: 0; left: 0;
      width: 260px; max-width: 85vw;
      height: 100vh !important;
      z-index: 200;
      transform: translateX(-100%);
      transition: transform .25s ease;
      padding-top: 12px;
      box-shadow: 6px 0 32px rgba(0,0,0,.35);
    }
    .admin-side.open { transform: translateX(0); }

    .admin-overlay {
      display: block !important;
      position: fixed !important; inset: 0 !important;
      background: rgba(15,23,42,.5) !important;
      z-index: 199 !important;
      opacity: 0; pointer-events: none;
      transition: opacity .2s;
    }
    .admin-overlay.open { opacity: 1 !important; pointer-events: auto !important; }

    .stat-grid { grid-template-columns: repeat(2, 1fr) !important; gap: 10px !important; margin-bottom: 18px !important; }
    .stat-card { padding: 10px 12px !important; gap: 8px !important; }
    .stat-num { font-size: 19px !important; }
    .stat-card > span:last-child { font-size: 12px !important; }

    .admin-main table { display: block !important; overflow-x: auto !important; white-space: nowrap !important; }
    .admin-form, .form-grid, .form-row { grid-template-columns: 1fr !important; }
  }

  @media (max-width: 480px) {
    .stat-num { font-size: 17px; }
    .admin-main input, .admin-main select, .admin-main textarea { font-size: 16px; }
  }
</style>
<link rel="stylesheet" href="<%= asset('/css/responsive.css') %>">

<style id="admin-hard-overflow-fix">
  html, body {
    overflow-x: clip !important;
    overflow-x: hidden !important;
    max-width: 100% !important;
    width: 100% !important;
    position: relative;
  }
  .admin-shell, .admin-main {
    max-width: 100vw !important;
    width: 100% !important;
    overflow-x: hidden !important;
  }
  @media (max-width: 900px) {
    .admin-main * {
      max-width: 100% !important;
      min-width: 0 !important;
      box-sizing: border-box !important;
    }
    .admin-main table {
      display: block !important;
      max-width: 100% !important;
      overflow-x: auto !important;
    }
    .admin-main svg, .admin-main canvas { max-width: 100% !important; height: auto !important; }
    .admin-main [class*="chart"], .admin-main [id*="chart"] {
      width: 100% !important;
      max-width: 100% !important;
      overflow-x: auto !important;
    }
  }
</style>

<style id="admin-header-v5">
@media (max-width: 900px) {
  /* ── Burger: строго 38×38, слева сверху ── */
  .admin-burger,
  button.admin-burger {
    display: flex !important;
    position: absolute !important;
    top: 10px !important; left: 10px !important;
    width: 38px !important; min-width: 38px !important; max-width: 38px !important;
    height: 38px !important; min-height: 38px !important; max-height: 38px !important;
    padding: 0 !important; border-radius: 9px !important;
    background: #0f172a !important; color: #fff !important;
    border: 0 !important; font-size: 17px !important; line-height: 1 !important;
    align-items: center !important; justify-content: center !important;
    z-index: 100 !important; box-sizing: border-box !important;
    flex-shrink: 0 !important;
  }

  /* ── Header: одна строка, без переносов ── */
  .admin-header {
    padding: 0 0 0 48px !important;
    margin: 0 0 10px !important;
    min-height: 38px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 6px !important;
    flex-wrap: nowrap !important;
    box-sizing: border-box !important;
    width: 100% !important;
  }

  /* ── Заголовок: 16px, обрезается ellipsis если не влезает ── */
  .admin-header h1,
  .admin-header h2 {
    font-size: 16px !important;
    line-height: 1.2 !important;
    margin: 0 !important; padding: 0 !important;
    flex: 1 1 auto !important;
    min-width: 0 !important;
    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    font-weight: 700 !important;
  }

  /* ── Кнопки/ссылки справа: компактные, без переноса ── */
  .admin-header .btn,
  .admin-header button,
  .admin-header a.btn,
  .admin-header a[class*="btn"],
  .admin-header > a:not(.admin-burger) {
    flex: 0 0 auto !important;
    width: auto !important;
    max-width: 45% !important;
    font-size: 12px !important;
    padding: 6px 10px !important;
    line-height: 1.1 !important;
    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
  }

  /* ── Статистика пользователя в шапке — мелко ── */
  .admin-user,
  .admin-header > span:not(:first-child),
  .admin-header > div:not([class*="btn"]):not(:first-child) {
    font-size: 12px !important;
    flex: 0 0 auto !important;
    white-space: nowrap !important;
    max-width: 40% !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
  }
}

@media (max-width: 480px) {
  .admin-header { padding-left: 46px !important; }
  .admin-header h1, .admin-header h2 { font-size: 15px !important; }
  .admin-header .btn,
  .admin-header button,
  .admin-header > a:not(.admin-burger) {
    font-size: 11px !important; padding: 5px 8px !important;
  }
}
</style>
