<script id="admin-layout-v4-js">
(function(){
  var b = document.getElementById('adminBurger'),
      side = document.getElementById('adminSide'),
      ov = document.getElementById('adminOverlay');

  if (b && side && ov) {
    b.addEventListener('click', function(e){
      e.stopPropagation();
      side.classList.toggle('open');
      ov.classList.toggle('open');
    });
    ov.addEventListener('click', function(){
      side.classList.remove('open');
      ov.classList.remove('open');
    });
    side.querySelectorAll('a').forEach(function(a){
      a.addEventListener('click', function(){
        side.classList.remove('open');
        ov.classList.remove('open');
      });
    });
  }

  // группы меню
  document.querySelectorAll('.admin-group').forEach(function(g){
    var t = g.querySelector('.admin-group-toggle');
    if (!t) return;
    t.addEventListener('click', function(){ g.classList.toggle('open'); });
  });

  // активный пункт
  var path = window.location.pathname;
  document.querySelectorAll('.admin-side a').forEach(function(a){
    if (a.getAttribute('href') === path) a.classList.add('active');
  });
})();
</script>

<script src="/js/admin-sortable.js"></script>
<script src="/js/info-tips.js"></script>
</body>
