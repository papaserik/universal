<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Админ — <%= settings.siteName %></title>
<link rel="stylesheet" href="/css/base.css">
<link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">
<div class="admin-shell">
  <aside class="admin-side">
    <a href="/admin" class="admin-logo"><%= settings.siteName %></a>
    <nav class="admin-nav">
      <a href="/admin">📊 Дашборд</a>
      <a href="/admin/products">📦 Товары</a>
      <a href="/admin/categories">📂 Категории</a>
      <a href="/admin/options">🎛 Опции</a>
      <a href="/admin/orders">🛒 Заказы</a>
      <a href="/admin/blog">📝 Блог</a>
      <a href="/admin/pages">📄 Страницы</a>
      <a href="/admin/users">👥 Пользователи</a>
      <a href="/admin/import">📥 Импорт</a>
      <a href="/admin/settings">⚙ Настройки</a>
    </nav>
    <div class="admin-bottom">
      <a href="/" target="_blank">↗ На сайт</a>
      <a href="/logout">⎋ Выйти</a>
    </div>
  </aside>
  <main class="admin-main">
    <% if (typeof saved !== 'undefined' && saved) { %>
      <div class="admin-alert admin-alert-ok">Сохранено</div>
    <% } %>
    <%- body %>
  </main>
</div>
</body>
</html>
