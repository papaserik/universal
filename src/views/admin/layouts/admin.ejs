<style id="admin-stat-grid-v6">
/* stat-grid — всегда сетка, никогда не схлопывается в 1 колонку без причины */
.stat-grid {
  display: grid !important;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)) !important;
  gap: 10px !important;
}

/* Убираем все правила "grid→1fr" для stat-grid где бы они ни лежали */
@media (max-width: 1100px) {
  .stat-grid { grid-template-columns: repeat(2, 1fr) !important; }
}
@media (max-width: 900px) {
  .stat-grid { grid-template-columns: repeat(2, 1fr) !important; gap: 8px !important; }
}
@media (max-width: 480px) {
  .stat-grid { grid-template-columns: repeat(2, 1fr) !important; gap: 6px !important; }
}
/* Широкие карточки — на всю ширину грида */
.stat-card-wide { grid-column: 1 / -1 !important; }
</style>
<style id="admin-option-header-v7">
@media (max-width: 900px) {
  /* Строки с заголовком и кнопкой "Удалить" — переносим */
  .option-header,
  .option-row,
  .option-item,
  [class*="option-"] > header,
  [class*="option-"] > .row,
  .admin-main section > div:first-child {
    display: flex !important;
    flex-wrap: wrap !important;
    gap: 8px !important;
    align-items: center !important;
    justify-content: space-between !important;
  }

  /* Кнопки .btn-danger никогда не обрезаются */
  .btn-danger,
  button.btn-danger,
  a.btn-danger,
  [class*="delete"],
  [class*="remove"] {
    flex: 0 0 auto !important;
    max-width: 100% !important;
    white-space: nowrap !important;
    font-size: 13px !important;
    padding: 6px 12px !important;
  }

  /* Длинные заголовки — перенос, не обрезка */
  .admin-main h2, .admin-main h3, .admin-main h4 {
    flex: 1 1 auto !important;
    min-width: 0 !important;
    overflow-wrap: anywhere !important;
    word-break: break-word !important;
  }

  /* Значения-теги (Красный, Синий...) — перенос в 2 строки */
  .admin-main .tag,
  .admin-main .badge,
  .admin-main [class*="value-pill"] {
    max-width: 100% !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
  }
}

/* Универсально — если где-то кнопка «уезжает» вправо */
.admin-main .btn-danger { flex-shrink: 0 !important; }
</style>
<style id="admin-option-card-v9">
@media (max-width: 900px) {
  /* Карточка опции: h2 слева (обрезается), кнопка справа (компактная) */
  .admin-form .admin-header {
    flex-direction: row !important;
    flex-wrap: nowrap !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 8px !important;
  }
  .admin-form .admin-header h2,
  .admin-form .admin-header h3 {
    flex: 1 1 auto !important;
    min-width: 0 !important;
    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    font-size: 15px !important;
    margin: 0 !important;
  }
  .admin-form .admin-header form {
    flex: 0 0 auto !important;
    width: auto !important;
    display: block !important;
  }
  .admin-form .admin-header .btn,
  .admin-form .admin-header button {
    width: auto !important;
    max-width: none !important;
    flex: 0 0 auto !important;
    white-space: nowrap !important;
    overflow: visible !important;
    font-size: 12px !important;
    padding: 6px 10px !important;
  }
  /* Убираем лишние отступы у карточки */
  .admin-form { padding: 12px !important; }
}
</style>
<style id="admin-images-mobile-v11">
@media (max-width: 900px) {
  /* ── sales-stats (карточки метрик на /images) — 2×2 ── */
  .sales-stats {
    grid-template-columns: repeat(2, 1fr) !important;
    gap: 8px !important;
    display: grid !important;
  }
  .sales-stat {
    padding: 10px 12px !important;
    min-height: auto !important;
  }
  .sales-stat-label { font-size: 12px !important; line-height: 1.2 !important; }
  .sales-stat-value { font-size: 18px !important; }
  .sales-stat-sub  { font-size: 11px !important; }

  /* ── settings-layout: одна колонка ── */
  .settings-layout {
    grid-template-columns: 1fr !important;
    display: block !important;
    gap: 12px !important;
  }

  /* ── settings-section — компактнее ── */
  .settings-section {
    padding: 12px !important;
    margin-bottom: 12px !important;
    border-radius: 10px !important;
  }
  .settings-section-header { margin-bottom: 10px !important; }
  .settings-section-header h2 { font-size: 16px !important; margin: 0 0 4px !important; }
  .settings-section-desc { font-size: 12.5px !important; line-height: 1.4 !important; }

  /* ── settings-field — на всю ширину ── */
  .settings-field {
    margin-bottom: 12px !important;
    width: 100% !important;
    display: block !important;
  }
  .settings-field label {
    font-size: 13.5px !important;
    margin-bottom: 4px !important;
    display: block !important;
  }
  .settings-field input[type="text"],
  .settings-field input[type="number"],
  .settings-field select,
  .settings-field textarea {
    width: 100% !important;
    max-width: 100% !important;
    box-sizing: border-box !important;
    font-size: 16px !important;
    padding: 8px 10px !important;
  }
  .settings-field small {
    font-size: 11.5px !important;
    line-height: 1.35 !important;
    display: block !important;
    margin-top: 3px !important;
  }

  /* ── Кнопки в форме — на всю ширину ── */
  .settings-section form .btn,
  .settings-section > form > .btn {
    width: 100% !important;
    font-size: 14px !important;
    padding: 10px 12px !important;
  }

  /* ── admin-hint сверху ── */
  .admin-hint { font-size: 13px !important; line-height: 1.45 !important; }

  /* ── alert внутри ── */
  .admin-alert { font-size: 13px !important; padding: 8px 10px !important; }
}

@media (max-width: 480px) {
  .sales-stat-value { font-size: 16px !important; }
  .sales-stat-label { font-size: 11px !important; }
  .sales-stat-sub   { font-size: 10px !important; }
  .settings-section { padding: 10px !important; }
  .settings-section-header h2 { font-size: 15px !important; }
}
</style>
</head>
<body>

<div class="admin-shell">
  <aside class="admin-side" id="adminSide">
    <nav>
      <a href="/admin">📊 Дашборд</a>

      <div class="admin-group">
        <button type="button" class="admin-group-toggle"><span>📦 Каталог</span><span>›</span></button>
        <div class="admin-group-items">
          <a href="/admin/products">Товары</a>
          <a href="/admin/categories">Категории</a>
          <a href="/admin/options">Опции</a>
          <a href="/admin/brands">Бренды</a>
          <a href="/admin/tags">Теги</a>
        </div>
      </div>

      <div class="admin-group">
        <button type="button" class="admin-group-toggle"><span>💰 Продажи</span><span>›</span></button>
        <div class="admin-group-items">
          <a href="/admin/orders">Заказы</a>
          <a href="/admin/sales">Аналитика</a>
          <a href="/admin/sales/abandoned">Брошенные</a>
        </div>
      </div>

      <div class="admin-group">
