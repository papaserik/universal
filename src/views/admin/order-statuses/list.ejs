<div class="admin-header">
  <h1>🏷️ Статусы заказов</h1>
  <a href="/admin/order-statuses/new" class="btn">+ Добавить статус</a>
</div>
<p class="admin-hint">
  Статусы показываются в заказах. Для каждого можно включить автоматическое письмо клиенту при смене статуса.
</p>

<% if (req.query.error === 'default') { %>
  <div class="admin-alert" style="background:#fee2e2;color:#991b1b">Нельзя удалить статус по умолчанию</div>
<% } %>

<div class="admin-table-wrap">
  <table class="admin-table">
    <thead>
      <tr>
        <th style="width:60px;text-align:center">Иконка</th>
        <th>Название</th>
        <th style="width:140px">Код</th>
        <th style="width:90px;text-align:center">Заказов</th>
        <th style="width:220px">Уведомления</th>
        <th style="width:100px;text-align:center">Сортировка</th>
        <th style="width:110px;text-align:center">Статус</th>
        <th style="width:180px;text-align:right">Действия</th>
      </tr>
    </thead>
    <tbody>
      <% items.forEach(s => { %>
        <tr>
          <td style="font-size:22px;text-align:center"><%= s.icon || '—' %></td>
          <td>
            <span style="display:inline-block;padding:3px 10px;border-radius:12px;background:<%= s.color %>1a;color:<%= s.color %>;font-weight:600;font-size:12.5px">
              <%= s.name %>
            </span>
            <div class="cell-sub">
              <% if (s.isDefault) { %>· по умолчанию<% } %>
              <% if (s.isFinal) { %> · финальный<% } %>
            </div>
          </td>
          <td><code class="cell-code"><%= s.code %></code></td>
          <td style="text-align:center"><%= counts[s.code] || 0 %></td>
          <td>
            <% if (s.notifyClient) { %><span class="badge badge-paid">✉ Клиенту</span><% } %>
            <% if (s.notifyAdmin) { %><span class="badge badge-new">📨 Админу</span><% } %>
            <% if (!s.notifyClient && !s.notifyAdmin) { %><em style="color:#9ca3af">—</em><% } %>
          </td>
          <td style="text-align:center"><%= s.sort %></td>
          <td style="text-align:center">
            <% if (s.active) { %><span class="badge badge-paid">✓ Активен</span>
            <% } else { %><span class="badge">Отключён</span><% } %>
          </td>
          <td class="cell-actions">
            <a href="/admin/order-statuses/<%= s.id %>" class="btn btn-sm">Изменить</a>
            <% if (!s.isDefault) { %>
              <form method="post" action="/admin/order-statuses/<%= s.id %>/delete" onsubmit="return confirm('Удалить статус <%= s.name %>?')" class="inline-form">
                <button class="btn btn-sm btn-danger" title="Удалить">×</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
      <% if (!items.length) { %>
        <tr><td colspan="8" style="text-align:center;color:#9ca3af;padding:40px">Статусов нет</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
