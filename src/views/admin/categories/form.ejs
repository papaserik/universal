<div class="admin-header">
  <h1><%= cat ? 'Категория' : 'Новая категория' %></h1>
  <a href="/admin/categories" class="btn btn-sm">← К списку</a>
</div>

<form method="post" action="<%= cat ? '/admin/categories/' + cat.id : '/admin/categories' %>" class="admin-form" style="max-width:720px">
  <div class="form-row">
    <label>Название * <input type="text" name="name" value="<%= cat ? cat.name : '' %>" required></label>
    <label>Slug <input type="text" name="slug" value="<%= cat ? cat.slug : '' %>" placeholder="автогенерация"></label>
  </div>

  <fieldset>
    <legend>Изображение категории</legend>
    <p style="font-size:13px;color:#6b7280;margin:0 0 10px">Показывается на главной и в плитке категорий.</p>
    <div class="mp-icon-block">
      <div class="mp-icon-preview" id="cat-img-preview" style="width:100px;height:100px">
        <% if (cat && cat.imageUrl) { %>
          <img src="<%= cat.imageUrl %>" alt="">
        <% } else { %>
          <span style="font-size:32px;color:#9ca3af">📦</span>
        <% } %>
      </div>
      <div class="mp-icon-actions">
        <label class="upload-label-inline">📷 Загрузить
          <input type="file" id="cat-img-input" accept="image/*" hidden>
        </label>
        <input type="text" name="imageUrl" id="cat-img-url" value="<%= cat && cat.imageUrl ? cat.imageUrl : '' %>" placeholder="или URL">
        <% if (cat && cat.imageUrl) { %>
          <button type="button" class="btn-link" id="cat-img-clear">Удалить</button>
        <% } %>
      </div>
    </div>
  </fieldset>

  <div class="form-row">
    <label>Родитель
      <select name="parentId">
        <option value="">— нет —</option>
        <% categories.forEach(c => { %>
          <% if (!cat || c.id !== cat.id) { %>
            <option value="<%= c.id %>" <%= cat && cat.parentId === c.id ? 'selected' : '' %>><%= c.name %></option>
          <% } %>
        <% }) %>
      </select>
    </label>
    <label>Сортировка <input type="number" name="sort" value="<%= cat ? cat.sort : 0 %>"></label>
  </div>

  <label>SEO Title <input type="text" name="seoTitle" value="<%= cat && cat.seoTitle ? cat.seoTitle : '' %>"></label>
  <label>SEO Description <input type="text" name="seoDesc" value="<%= cat && cat.seoDesc ? cat.seoDesc : '' %>"></label>

  <div class="form-actions"><button class="btn">Сохранить</button></div>
</form>

<script>
(function () {
  var input = document.getElementById('cat-img-input');
  var url = document.getElementById('cat-img-url');
  var preview = document.getElementById('cat-img-preview');
  if (!input) return;
  input.addEventListener('change', function (e) {
    var f = e.target.files[0]; if (!f) return;
    var fd = new FormData(); fd.append('files', f);
    fetch('/admin/products/upload-images', { method: 'POST', body: fd })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        if (d.ok && d.urls && d.urls[0]) {
          url.value = d.urls[0];
          preview.innerHTML = '<img src="' + d.urls[0] + '" alt="">';
        }
      });
  });
  url.addEventListener('input', function () {
    if (url.value) preview.innerHTML = '<img src="' + url.value + '" alt="">';
    else preview.innerHTML = '<span style="font-size:32px;color:#9ca3af">📦</span>';
  });
  var clr = document.getElementById('cat-img-clear');
  if (clr) clr.addEventListener('click', function () {
    url.value = '';
    preview.innerHTML = '<span style="font-size:32px;color:#9ca3af">📦</span>';
  });
})();
</script>
