<div class="admin-header">
  <h1>Категории</h1>
  <a href="/admin/categories/new" class="btn">+ Добавить</a>
</div>

<table class="admin-table">
  <thead><tr><th style="width:60px">Иконка</th><th>Название</th><th>Slug</th><th>Товаров</th><th>Сортировка</th><th></th></tr></thead>
  <tbody>
    <% categories.forEach(c => { %>
      <tr>
        <td>
          <% if (c.imageUrl) { %>
            <img src="<%= c.imageUrl %>" alt="" style="width:40px;height:40px;object-fit:cover;border-radius:6px">
          <% } else { %>
            <span style="font-size:22px;color:#9ca3af">📦</span>
          <% } %>
        </td>
        <td><%= c.name %></td>
        <td>/catalog/<%= c.slug %></td>
        <td><%= c._count.products %></td>
        <td><%= c.sort %></td>
        <td class="row-actions">
          <a href="/admin/categories/<%= c.id %>" class="btn btn-sm">Изменить</a>
          <form method="post" action="/admin/categories/<%= c.id %>/delete" onsubmit="return confirm('Удалить категорию?')">
            <button class="btn btn-sm btn-danger">×</button>
          </form>
        </td>
      </tr>
    <% }) %>
    <% if (!categories.length) { %><tr><td colspan="6">Нет категорий</td></tr><% } %>
  </tbody>
</table>
