<div class="admin-header">
  <h1>Категории</h1>
  <a href="/admin/categories/new" class="btn">+ Добавить категорию</a>
</div>
<p class="admin-hint">
  Изображение показывается в плитке категорий на главной витрине.
</p>

<div class="admin-table-wrap">
  <table class="admin-table admin-table-sortable" data-sortable="categories">
    <thead>
      <tr>
        <th style="width:36px"></th>
        <th style="width:64px">Фото</th>
        <th style="width:60px">ID</th>
        <th>Название</th>
        <th>Slug</th>
        <th style="width:80px;text-align:center">Товаров</th>
        <th style="width:100px;text-align:center">Сортировка</th>
        <th style="width:180px;text-align:right">Действия</th>
      </tr>
    </thead>
    <tbody>
      <% categories.forEach(c => { %>
        <tr data-id="<%= c.id %>">
          <td class="drag-handle-cell">
            <span class="drag-handle" title="Перетащите">⋮⋮</span>
          </td>
          <td>
            <% if (c.imageUrl) { %>
              <img src="<%= c.imageUrl %>" alt="" class="row-thumb">
            <% } else { %>
              <div class="row-thumb row-thumb-empty">📦</div>
            <% } %>
          </td>
          <td><%= c.id %></td>
          <td>
            <div class="cell-title"><%= c.name %></div>
            <% if (c.parentId) {
                 const parent = categories.find(x => x.id === c.parentId);
            %>
              <div class="cell-sub">↳ в «<%= parent ? parent.name : '—' %>»</div>
            <% } %>
          </td>
          <td><code class="cell-code">/catalog/<%= c.slug %></code></td>
          <td style="text-align:center"><%= c._count.products %></td>
          <td style="text-align:center"><%= c.sort %></td>
          <td class="cell-actions">
            <a href="/admin/categories/<%= c.id %>" class="btn btn-sm">Изменить</a>
            <form method="post" action="/admin/categories/<%= c.id %>/delete" onsubmit="return confirm('Удалить категорию?')" class="inline-form">
              <button class="btn btn-sm btn-danger" title="Удалить">×</button>
            </form>
          </td>
        </tr>
      <% }) %>
      <% if (!categories.length) { %>
        <tr><td colspan="8" style="text-align:center;color:#9ca3af;padding:40px">Нет категорий</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
