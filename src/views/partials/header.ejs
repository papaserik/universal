<header class="site-header">
  <div class="container header-inner">

    <%# Логотип %>
    <a href="/" class="logo">
      <% if (settings.logoImage) { %>
        <img src="<%= settings.logoImage %>" alt="<%= settings.siteName %>" class="logo-img">
      <% } else { %>
        <%= settings.logoText || settings.siteName %>
      <% } %>
    </a>

    <%# Поиск %>
    <div class="header-search" data-search>
      <form method="get" action="/search" autocomplete="off">
        <input type="text" name="q" class="js-search-input" placeholder="Поиск товаров…"
               value="<%= (req.query && req.query.q) || '' %>" data-suggest-url="/api/search/suggest">
        <button type="submit" aria-label="Найти">🔍</button>
        <div class="search-suggest" data-suggest-box hidden></div>
      </form>
    </div>

    <%# Правый блок: навигация → корзина → профиль → гамбургер %>
    <div class="header-right">

      <%# Навигация по разделам %>
      <nav class="nav" id="main-nav">
        <a href="/catalog">Каталог</a>
        <% if (moduleEnabled('blog')) { %><a href="/blog">Блог</a><% } %>
        <a href="/contacts">Контакты</a>
        <% if (user) { %>
          <% if (user.role !== 'USER') { %><a href="/admin">Админка</a><% } %>
          <% if (moduleEnabled('loyalty')) { %><% if (userLoyalty && userLoyalty.current) { %>
            <a href="/account/loyalty" class="loyalty-badge" title="<%= userLoyalty.balance %> доступно<% if (referralPending > 0) { %>, <%= referralPending %> заблокировано<% } %>">
              <%= userLoyalty.current.icon || '⭐' %>
              <strong><%= userLoyalty.balance %></strong>
              <% if (referralPending > 0) { %><span class="pending-badge">+<%= referralPending %></span><% } %>
            </a>
          <% } %><% } %>
          <a href="/logout">Выйти</a>
        <% } else { %>
          <a href="/login">Войти</a>
        <% } %>
      </nav>

      <%# Иконка корзины — правее навигации %>
      <% if (moduleEnabled('favorites')) { %><a href="/favorites" class="header-icon-btn" aria-label="Избранное">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
        <span class="header-icon-count js-favorites-count" <%= !favoritesCount || favoritesCount === 0 ? 'hidden' : '' %>><%= favoritesCount || 0 %></span>
      </a><% } %>
      <a href="/cart" class="header-icon-btn" aria-label="Корзина">
        🛒 <span class="header-icon-count js-cart-count"><%= cartCount %></span>
      </a>

      <%# Аватар пользователя %>
      <% if (user) { %>
        <a href="/account" class="header-icon-btn" aria-label="Личный кабинет">
          <% if (user.avatar) { %>
            <img src="<%= user.avatar %>" alt="" class="user-avatar-sm">
          <% } else { %>
            <span class="user-avatar-sm user-avatar-initial"><%= (user.name || user.email).charAt(0).toUpperCase() %></span>
          <% } %>
        </a>
      <% } %>

      <%# Гамбургер — самый правый %>
      <button type="button" class="hamburger" id="hamburger" aria-label="Меню" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>

    </div>

  </div>

      <%# Мобильное меню %>
  <div class="mobile-menu" id="mobile-menu" hidden>
    <div class="mobile-menu-inner">

      <%# Шапка меню: логотип + закрыть %>
      <div class="mm-head">
        <div class="mm-logo"><%= settings.siteName %></div>
      </div>

      <%# Поиск %>
      <form method="get" action="/search" class="mm-search">
        <input type="text" name="q" placeholder="Найти товар…"
               value="<%= (req.query && req.query.q) || '' %>">
        <button type="submit" aria-label="Найти">🔍</button>
      </form>

      <%# Баланс баллов — если авторизован и есть программа %>
      <% if (user && userLoyalty && userLoyalty.current) { %>
        <a href="/account/loyalty" class="mm-loyalty">
          <div class="mm-loyalty-icon"><%= userLoyalty.current.icon || '⭐' %></div>
          <div class="mm-loyalty-body">
            <div class="mm-loyalty-name"><%= userLoyalty.current.name %> уровень</div>
            <div class="mm-loyalty-points"><strong><%= userLoyalty.balance %></strong> баллов</div>
          </div>
          <div class="mm-loyalty-arrow">→</div>
        </a>
      <% } %>

      <%# Главная кнопка — в каталог %>
      <a href="/catalog" class="mm-cta">
        <span class="mm-cta-icon">🛍️</span>
        <span class="mm-cta-text">Перейти в каталог</span>
      </a>

      <%# Секция «Магазин» %>
      <div class="mm-section">
        <div class="mm-section-title">Магазин</div>
        <a href="/catalog" class="mm-item">
          <span class="mm-item-icon">📦</span>
          <span class="mm-item-text">
            <strong>Каталог товаров</strong>
            <small>Все категории и новинки</small>
          </span>
        </a>
        <a href="/blog" class="mm-item">
          <span class="mm-item-icon">📝</span>
          <span class="mm-item-text">
            <strong>Блог</strong>
            <small>Обзоры, новости, советы</small>
          </span>
        </a>
      </div>

      <%# Секция «Аккаунт» %>
      <% if (user) { %>
        <div class="mm-section">
          <div class="mm-section-title">Мой аккаунт</div>
          <a href="/account" class="mm-item">
            <span class="mm-item-icon">
              <% if (user.avatar) { %>
                <img src="<%= user.avatar %>" alt="" class="mm-avatar">
              <% } else { %>
                <span class="mm-avatar-initial"><%= (user.name || user.email).charAt(0).toUpperCase() %></span>
              <% } %>
            </span>
            <span class="mm-item-text">
              <strong><%= user.name || user.email %></strong>
              <small>Личный кабинет</small>
            </span>
          </a>
          <a href="/account/orders" class="mm-item">
            <span class="mm-item-icon">📋</span>
            <span class="mm-item-text">
              <strong>Мои заказы</strong>
              <small>История покупок</small>
            </span>
          </a>
          <% if (moduleEnabled('club')) { %><a href="/account/club" class="mm-item mm-item-club">
            <span class="mm-item-icon">🎁</span>
            <span class="mm-item-text">
              <strong>Клуб</strong>
              <small>Приглашайте друзей — получайте баллы</small>
            </span>
          </a><% } %>
          <% if (moduleEnabled('loyalty')) { %><a href="/account/loyalty" class="mm-item">
            <span class="mm-item-icon">⭐</span>
            <span class="mm-item-text">
              <strong>Баллы и уровни</strong>
              <small>Кэшбэк и скидки</small>
            </span>
          </a><% } %>
          <% if (user.role !== 'USER') { %>
            <a href="/admin" class="mm-item mm-item-admin">
              <span class="mm-item-icon">⚙</span>
              <span class="mm-item-text">
                <strong>Админ-панель</strong>
                <small>Управление магазином</small>
              </span>
            </a>
          <% } %>
        </div>
      <% } %>

      <%# Секция «Помощь» %>
      <div class="mm-section">
        <div class="mm-section-title">Помощь</div>
        <a href="/contacts" class="mm-item">
          <span class="mm-item-icon">📞</span>
          <span class="mm-item-text">
            <strong>Связаться с нами</strong>
            <small>Вопросы и поддержка</small>
          </span>
        </a>
        <a href="/page/privacy-policy" class="mm-item">
          <span class="mm-item-icon">🔒</span>
          <span class="mm-item-text">
            <strong>Политика конфиденциальности</strong>
          </span>
        </a>
      </div>

      <%# Кнопка входа/выхода — внизу %>
      <div class="mm-bottom">
        <% if (user) { %>
          <a href="/logout" class="mm-logout">Выйти из аккаунта</a>
        <% } else { %>
          <a href="/login" class="mm-login">
            <span>Войти в аккаунт</span>
          </a>
          <a href="/register" class="mm-register">Создать аккаунт</a>
        <% } %>
      </div>

    </div>
  </div>

</header>

<script>
(function () {
  var btn = document.getElementById('hamburger');
  var menu = document.getElementById('mobile-menu');
  if (!btn || !menu) return;
  btn.addEventListener('click', function () {
    var isOpen = !menu.hidden;
    menu.hidden = isOpen;
    btn.classList.toggle('open', !isOpen);
    btn.setAttribute('aria-expanded', String(!isOpen));
    document.body.style.overflow = !isOpen ? 'hidden' : '';
  });
  document.addEventListener('click', function (e) {
    if (menu.hidden) return;
    if (!menu.contains(e.target) && !btn.contains(e.target)) {
      menu.hidden = true;
      btn.classList.remove('open');
      document.body.style.overflow = '';
    }
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && !menu.hidden) {
      menu.hidden = true;
      btn.classList.remove('open');
      document.body.style.overflow = '';
    }
  });
})();
</script>
