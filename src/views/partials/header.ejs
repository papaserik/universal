
<header class="site-header"><div class="container header-inner">
  <a href="/" class="logo">
    <% if (settings.logoImage) { %>
      <img src="<%= settings.logoImage %>" alt="<%= settings.siteName %>" class="logo-img">
    <% } else { %>
      <%= settings.logoText || settings.siteName %>
    <% } %>
  </a>
  <div class="header-search" data-search>
    <form method="get" action="/search" autocomplete="off">
      <input type="text" name="q" class="js-search-input" placeholder="Поиск товаров…" value="<%= (req.query && req.query.q) || '' %>" data-suggest-url="/api/search/suggest">
      <button type="submit" aria-label="Найти">🔍</button>
      <div class="search-suggest" data-suggest-box hidden></div>
    </form>
  </div>
  <nav class="nav">
    <a href="/catalog">Каталог</a>
    <a href="/blog">Блог</a>
    <a href="/contacts">Контакты</a>
    <a href="/cart" class="cart-link">Корзина (<span class="js-cart-count"><%= cartCount %></span>)</a>
    <% if (user) { %>
      <% if (user.role !== 'USER') { %><a href="/admin">Админка</a><% } %>
      <% if (userLoyalty && userLoyalty.current) { %>
        <a href="/account/orders" class="loyalty-badge" title="<%= userLoyalty.current.name %> · <%= userLoyalty.balance %> баллов">
          <%= userLoyalty.current.icon || '⭐' %>
          <strong><%= userLoyalty.balance %></strong>
        </a>
      <% } %>
      <a href="/account" class="user-link">
        <% if (user.avatar) { %>
          <img src="<%= user.avatar %>" alt="" class="user-avatar">
        <% } else { %>
          <span class="user-avatar user-avatar-initial">
            <%= (user.name || user.email).charAt(0).toUpperCase() %>
          </span>
        <% } %>
        Кабинет
      </a>
      <a href="/logout">Выйти</a>
    <% } else { %>
      <a href="/login">Войти</a>
    <% } %>
  </nav>
</div></header>
