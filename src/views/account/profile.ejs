<div class="cabinet">
  <h1>Профиль и адрес доставки</h1>

  <%- include('partials/tabs', { activeTab: 'profile' }) %>

  <% if (saved) { %><div class="admin-alert admin-alert-ok">✓ Профиль и адрес сохранены</div><% } %>

  <form method="post" action="/account/profile" class="cabinet-form">

    <section class="cabinet-block">
      <h2>Личные данные</h2>

      <div class="avatar-uploader">
        <div class="avatar-preview" id="avatar-preview">
          <% if (profile.avatar) { %>
            <img src="<%= profile.avatar %>" alt="">
          <% } else { %>
            <span class="avatar-initial"><%= (profile.name || profile.email).charAt(0).toUpperCase() %></span>
          <% } %>
        </div>
        <div class="avatar-actions">
          <label class="upload-label-inline">📷 Загрузить аватар
            <input type="file" id="avatar-input" accept="image/*" hidden>
          </label>
          <% if (profile.avatar) { %>
            <button type="button" id="avatar-remove" class="btn-link">Удалить аватар</button>
          <% } %>
          <p class="avatar-hint">JPG, PNG или SVG. Рекомендуется квадратное изображение.</p>
        </div>
      </div>

      <div class="cabinet-form-row">
        <label>Имя
          <input type="text" name="name" value="<%= profile.name || '' %>">
        </label>
        <label>Email (нельзя изменить)
          <input type="email" value="<%= profile.email %>" disabled>
        </label>
      </div>
    </section>

    <section class="cabinet-block">
      <h2>Адрес доставки</h2>
      <p class="cabinet-hint">Сохраните адрес — при следующем заказе он подставится автоматически.</p>

      <div class="cabinet-form-row">
        <label>Имя получателя
          <input type="text" name="savedName" value="<%= profile.savedName || '' %>" placeholder="Иван Иванов">
        </label>
        <label>Телефон
          <input type="tel" name="savedPhone" value="<%= profile.savedPhone || '' %>" placeholder="+7 (900) 000-00-00">
        </label>
      </div>

      <div class="cabinet-form-row">
        <label>Почтовый индекс
          <input type="text" name="postalCode" value="<%= savedAddress.postalCode || '' %>" placeholder="123456">
        </label>
        <label>Город
          <input type="text" name="city" value="<%= savedAddress.city || '' %>" placeholder="Москва">
        </label>
      </div>

      <label class="cabinet-form-full">Адрес
        <input type="text" name="address" value="<%= savedAddress.address || '' %>" placeholder="ул. Примерная, д. 1, кв. 5">
      </label>
    </section>

    <div class="cabinet-form-actions">
      <button type="submit" class="btn">💾 Сохранить</button>
      <a href="/account" class="btn btn-outline">Отмена</a>
    </div>
  </form>

  <section class="cabinet-block" style="margin-top:20px">
    <h2>Безопасность</h2>
    <p class="cabinet-hint">
      Вход возможен по паролю или по коду на email. Email: <strong><%= profile.email %></strong>
    </p>
    <a href="/logout" class="btn btn-outline">Выйти</a>
  </section>
</div>

<script>
(function () {
  // Загрузка аватара
  var input = document.getElementById('avatar-input');
  if (input) {
    input.addEventListener('change', function (e) {
      var file = e.target.files[0];
      if (!file) return;
      var fd = new FormData();
      fd.append('avatar', file);
      fetch('/account/avatar', { method: 'POST', body: fd })
        .then(function (r) { return r.json(); })
        .then(function (d) {
          if (d.ok) {
            document.getElementById('avatar-preview').innerHTML =
              '<img src="' + d.url + '?t=' + Date.now() + '" alt="">';
            setTimeout(function () { location.reload(); }, 500);
          } else {
            alert('Ошибка загрузки');
          }
        })
        .catch(function () { alert('Ошибка сети'); });
    });
  }

  // Удаление аватара — через fetch, без вложенной формы
  var rm = document.getElementById('avatar-remove');
  if (rm) {
    rm.addEventListener('click', function () {
      if (!confirm('Удалить аватар?')) return;
      fetch('/account/avatar/remove', { method: 'POST' })
        .then(function () { location.reload(); });
    });
  }
})();
</script>
