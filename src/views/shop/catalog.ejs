<h1>Каталог</h1>
<div class="catalog-layout">
  <aside class="filters">
    <form method="get">
      <fieldset>
        <legend>Цена</legend>
        <input type="number" name="min" placeholder="от" value="<%= req.query.min || '' %>">
        <input type="number" name="max" placeholder="до" value="<%= req.query.max || '' %>">
      </fieldset>
      <% options.forEach(o => { %>
        <fieldset>
          <legend><%= o.name %></legend>
          <% o.values.forEach(v => { %>
            <label>
              <input type="checkbox" name="opt[<%= o.slug %>]" value="<%= v.slug %>">
              <%= v.value %>
            </label>
          <% }) %>
        </fieldset>
      <% }) %>
      <button type="submit" class="btn btn-sm">Применить</button>
    </form>
  </aside>
  <div class="catalog-main">
    <div class="sort-row">
      Сортировка:
      <a href="?sort=new">Новые</a>
      <a href="?sort=price-asc">Цена ↑</a>
      <a href="?sort=price-desc">Цена ↓</a>
    </div>
    <p>Товаров: <%= products.length %></p>
    <div class="products-grid">
      <% products.forEach(p => { %>
        <article class="product-card">
          <a href="/product/<%= p.slug %>"><h3><%= p.name %></h3></a>
          <div class="price-row">
            <% if (p.oldPrice && p.oldPrice > p.price) { %>
              <s class="old"><%= p.oldPrice %> ₽</s>
              <span class="new"><%= p.price %> ₽</span>
            <% } else { %>
              <span class="price"><%= p.price %> ₽</span>
            <% } %>
          </div>
          <form class="add-form" data-product="<%= p.id %>">
            <button type="submit" class="btn btn-sm">В корзину</button>
          </form>
        </article>
      <% }) %>
    </div>
  </div>
</div>
