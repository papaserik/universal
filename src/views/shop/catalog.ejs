<% breadcrumbs = [{ name: 'Главная', url: '/' }, { name: 'Каталог', url: '/catalog' }]; %>
<%- include('../partials/breadcrumbs') %>
<h1>Каталог</h1>
<div class="catalog-layout">
  <aside class="filters">
    <form method="get">
      <fieldset>
        <legend>Цена</legend>
        <input type="number" name="min" placeholder="от" value="<%= req.query.min || '' %>">
        <input type="number" name="max" placeholder="до" value="<%= req.query.max || '' %>">
      </fieldset>
      <% options.forEach(o => { %>
        <fieldset>
          <legend><%= o.name %></legend>
          <% o.values.forEach(v => { %>
            <label>
              <input type="checkbox" name="opt[<%= o.slug %>]" value="<%= v.slug %>">
              <%= v.value %>
            </label>
          <% }) %>
        </fieldset>
      <% }) %>
      <button type="submit" class="btn btn-sm">Применить</button>
    </form>
  </aside>
  <div class="catalog-main">
    <div class="sort-row">
      Сортировка:
      <a href="?sort=new">Новые</a>
      <a href="?sort=price-asc">Цена ↑</a>
      <a href="?sort=price-desc">Цена ↓</a>
    </div>
    <p>Товаров: <%= products.length %></p>
    <div class="products-grid">
      <% products.forEach(p => { const imgs = JSON.parse(p.images || '[]'); %>
        <article class="product-card">
          <a href="/product/<%= p.slug %>" class="product-image">
            <% if (imgs.length) { %>
              <img src="<%= imgs[0] %>" alt="<%= p.name %>" loading="lazy">
            <% } else { %>
              <div class="no-image">Нет фото</div>
            <% } %>
            <% if (p.oldPrice && p.oldPrice > p.price) { %>
              <span class="badge-discount">-<%= Math.round((1 - p.price / p.oldPrice) * 100) %>%</span>
            <% } %>
          </a>
          <a href="/product/<%= p.slug %>"><h3><%= p.name %></h3></a>
          <div class="price-row">
            <% if (p.oldPrice && p.oldPrice > p.price) { %>
              <s class="old"><%= p.oldPrice %> ₽</s>
              <span class="new"><%= p.price %> ₽</span>
            <% } else { %>
              <span class="price"><%= p.price %> ₽</span>
            <% } %>
          </div>
          <div class="card-actions">
          <% if (p.stock > 0) { %>
            <form class="add-form" data-product="<%= p.id %>">
              <button type="submit" class="btn-card btn-card-primary">В корзину</button>
            </form>
          <% } %>
          <% let mpList = [];
               try { mpList = JSON.parse(p.marketplaceLinks || '[]'); } catch (e) {}
               if (!mpList.length && p.marketplace && p.marketplaceUrl) mpList = [{ slug: p.marketplace, url: p.marketplaceUrl }];
               mpList.forEach(mp => {
                 const mpName = marketplaces[mp.slug] || mp.slug;
                 const mpSlug = (mp.slug || '').toLowerCase();
                 const mpColor = mpSlug === 'ozon' ? 'mp-ozon' : mpSlug === 'wildberries' ? 'mp-wb' : 'mp-default';
            %>
              <a class="btn-card <%= mpColor %>" href="<%= mp.url %>" target="_blank" rel="noopener nofollow">
                Купить на <%= mpName %>
              </a>
            <% }) %>
        </div>
        </article>
      <% }) %>
    </div>
  </div>
</div>
