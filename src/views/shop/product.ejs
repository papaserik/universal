<%- include('../partials/breadcrumbs') %>
<% const imgs = JSON.parse(p.images || '[]'); %>
<%
  let mpList = [];
  try { mpList = JSON.parse(p.marketplaceLinks || '[]'); } catch (e) { mpList = []; }
  if (!mpList.length && p.marketplace && p.marketplaceUrl) {
    mpList = [{ slug: p.marketplace, url: p.marketplaceUrl }];
  }
%>
<article class="product-page">
  <div class="product-layout">
    <div class="product-gallery" data-gallery='<%= JSON.stringify(imgs) %>'>
      <% if (imgs.length) { %>
        <div class="gallery-main">
          <img src="<%= imgs[0] %>" alt="<%= p.name %>" title="Нажмите для увеличения">
          <% if (p.oldPrice && p.oldPrice > p.price) { %>
            <span class="badge-discount badge-discount-lg">-<%= Math.round((1 - p.price / p.oldPrice) * 100) %>%</span>
          <% } %>
          <% if (imgs.length > 1) { %>
            <button type="button" class="gallery-prev" aria-label="Назад">‹</button>
            <button type="button" class="gallery-next" aria-label="Вперёд">›</button>
            <span class="gallery-counter">1 / <%= imgs.length %></span>
          <% } %>
        </div>
        <% if (imgs.length > 1) { %>
          <div class="thumbs">
            <% imgs.forEach((url, i) => { %>
              <img src="<%= url %>" class="<%= i === 0 ? 'active' : '' %>" alt="">
            <% }) %>
          </div>
        <% } %>
      <% } else { %>
        <div class="gallery-main no-image">Нет фото</div>
      <% } %>
    </div>

    <div class="product-info">
      <h1><%= p.name %></h1>
      <div class="price-row price-row-lg">
        <% if (p.oldPrice && p.oldPrice > p.price) { %>
          <s class="old"><%= p.oldPrice %> ₽</s>
          <span class="new"><%= p.price %> ₽</span>
          <% } else { %>
          <span class="price"><%= p.price %> ₽</span>
        <% } %>
      </div>

      <% if (p.stock > 0) { %>
        <div class="stock-info"><span class="in-stock">✓ В наличии (<%= p.stock %> шт.)</span></div>
      <% } %>

      <% if (p.options && p.options.length) { %>
        <div class="product-options">
          <% const grouped = {}; p.options.forEach(o => { (grouped[o.option.name] = grouped[o.option.name] || []).push(o.value); }); %>
          <% Object.entries(grouped).forEach(([name, values]) => { %>
            <div class="opt-group">
              <strong><%= name %>:</strong>
              <% values.forEach(v => { %><span class="opt"><%= v.value %></span><% }) %>
            </div>
          <% }) %>
        </div>
      <% } %>

      <% if (p.stock > 0) { %>
        <form class="add-form add-form-lg" data-product="<%= p.id %>">
          <div class="qty-wrap">
            <button type="button" class="qty-dec" aria-label="Меньше">−</button>
            <input type="number" name="qty" value="1" min="1" max="<%= p.stock %>">
            <button type="button" class="qty-inc" aria-label="Больше">+</button>
          </div>
          <button type="submit" class="btn">Добавить в корзину</button>
        </form>
      <% } %>

      <% mpList.forEach(mp => {
           const mpName = marketplaces[mp.slug] || mp.slug;
           const mpSlug = (mp.slug || '').toLowerCase();
           const mpColor = mpSlug === 'ozon' ? 'mp-ozon' : mpSlug === 'wildberries' ? 'mp-wb' : 'mp-default';
      %>
        <a class="btn-card btn-card-lg <%= mpColor %>" style="margin-top:6px"
           href="<%= mp.url %>" target="_blank" rel="noopener nofollow">
          Купить на <%= mpName %>
        </a>
      <% }) %>

      <% if (p.description) { %>
        <div class="description">
          <h3>Описание</h3>
          <%- p.description %>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Отзывы -->
  <section class="product-reviews" id="reviews">
    <h2>
      Отзывы
      <% if (rating && rating.count > 0) { %>
        <span class="reviews-rating">
          <%= '★'.repeat(Math.round(rating.avg)) %><%= '☆'.repeat(5 - Math.round(rating.avg)) %>
          <strong><%= rating.avg %></strong>
          <small>(<%= rating.count %> <%= rating.count === 1 ? 'отзыв' : 'отзывов' %>)</small>
        </span>
      <% } %>
    </h2>

    <% if (productReviews.length) { %>
      <ul class="reviews-list">
        <% productReviews.forEach(r => { %>
          <li class="review-item">
            <div class="review-header">
              <div class="review-author">
                <span class="review-avatar"><%= r.name.charAt(0).toUpperCase() %></span>
                <div>
                  <strong><%= r.name %></strong>
                  <% if (r.userId && r.orderId) { %><span class="review-verified">✓ Купил</span><% } %>
                  <div class="review-date"><%= r.createdAt.toLocaleDateString('ru-RU') %></div>
                </div>
              </div>
              <div class="review-stars"><%= '★'.repeat(r.rating) %><%= '☆'.repeat(5 - r.rating) %></div>
            </div>
            <p class="review-text"><%= r.text %></p>
          </li>
        <% }) %>
      </ul>
    <% } else { %>
      <p class="reviews-empty">Отзывов пока нет. Будьте первым!</p>
    <% } %>

    <div class="review-form-wrap">
      <h3>Оставить отзыв</h3>

      <% if (!canReview) { %>
        <p class="review-login-hint">
          <a href="/login">Войдите</a> или <a href="/login/code">получите код на email</a>, чтобы оставить отзыв и получить баллы.
        </p>
      <% } else if (alreadyReviewed) { %>
        <p class="review-login-hint">Вы уже оставляли отзыв об этом товаре. Спасибо!</p>
      <% } else { %>
        <form class="review-form" id="review-form" data-product-id="<%= p.id %>">
          <div class="review-form-row">
            <label>Ваше имя
              <input type="text" name="name" value="<%= user.name || '' %>" required>
            </label>
            <label>Оценка
              <div class="review-rating-input">
                <input type="radio" name="rating" value="5" id="r5" checked><label for="r5">★</label>
                <input type="radio" name="rating" value="4" id="r4"><label for="r4">★</label>
                <input type="radio" name="rating" value="3" id="r3"><label for="r3">★</label>
                <input type="radio" name="rating" value="2" id="r2"><label for="r2">★</label>
                <input type="radio" name="rating" value="1" id="r1"><label for="r1">★</label>
              </div>
            </label>
          </div>
          <label>Текст отзыва
            <textarea name="text" rows="4" required minlength="10" maxlength="3000" placeholder="Что понравилось, что нет…"></textarea>
          </label>

          <!-- Honeypot — невидимое поле для ботов -->
          <input type="text" name="website" style="position:absolute;left:-9999px" tabindex="-1" autocomplete="off" aria-hidden="true">

          <button type="submit" class="btn">Отправить отзыв</button>
          <p class="review-hint">Отзыв появится после модерации. За отзыв мы начисляем баллы 💰</p>
        </form>
        <div id="review-result"></div>
      <% } %>
    </div>
  </section>

  <% if (related.length) { %>
    <section>
      <h2>Похожие товары</h2>
      <div class="products-grid">
        <% related.forEach(r => {
             const rImgs = JSON.parse(r.images || '[]');
             %>
          <article class="product-card">
            <a href="/product/<%= r.slug %>" class="product-image">
              <% if (rImgs.length) { %><img src="<%= rImgs[0] %>" alt="<%= r.name %>" loading="lazy">
              <% } else { %><div class="no-image">Нет фото</div><% } %>
              <% if (r.oldPrice && r.oldPrice > r.price) { %>
                <span class="badge-discount">-<%= Math.round((1 - r.price / r.oldPrice) * 100) %>%</span>
              <% } %>
            </a>
            <a href="/product/<%= r.slug %>"><h3><%= r.name %></h3></a>
            <span class="price"><%= r.price %> ₽</span>
            <% if (r.stock === 0) {
                 let rMps = [];
                 try { rMps = JSON.parse(r.marketplaceLinks || '[]'); } catch (e) {}
                 if (!rMps.length && r.marketplace && r.marketplaceUrl) rMps = [{ slug: r.marketplace, url: r.marketplaceUrl }];
                 const firstMp = rMps[0];
                 if (firstMp) {
                   const rMpSlug = (firstMp.slug || '').toLowerCase();
                   const rMpColor = rMpSlug === 'ozon' ? 'mp-ozon' : rMpSlug === 'wildberries' ? 'mp-wb' : 'mp-default';
            %>
              <a class="btn-card <%= rMpColor %>" href="<%= firstMp.url %>" target="_blank" rel="noopener nofollow">
                Купить на <%= marketplaces[firstMp.slug] || firstMp.slug %>
              </a>
            <% } } %>
          </article>
        <% }) %>
      </div>
    </section>
  <% } %>
</article>

<div class="image-modal" id="image-modal">
  <button type="button" class="modal-close" aria-label="Закрыть">×</button>
  <img src="" alt="">
</div>


<script>
(function () {
  var form = document.getElementById('review-form');
  if (!form) return;
  form.addEventListener('submit', function (e) {
    e.preventDefault();
    var productId = form.dataset.productId;
    var data = {
      name: form.name.value,
      text: form.text.value,
      rating: form.querySelector('input[name="rating"]:checked').value,
      website: form.website ? form.website.value : ''
    };
    fetch('/product/' + productId + '/review', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        var result = document.getElementById('review-result');
        if (d.ok) {
          form.style.display = 'none';
          result.innerHTML = '<div class="review-success">✓ Спасибо! Отзыв отправлен на модерацию. Баллы зачислены.</div>';
        } else {
          result.innerHTML = '<div class="review-error">' + (d.error || 'Ошибка') + '</div>';
        }
      })
      .catch(function () {
        document.getElementById('review-result').innerHTML = '<div class="review-error">Ошибка сети</div>';
      });
  });
})();
</script>