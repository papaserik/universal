<h1>Корзина</h1>

<% if (!items.length) { %>
  <div class="cart-empty">
    <div class="cart-empty-icon">🛒</div>
    <h2>Корзина пуста</h2>
    <p>Добавьте товары из каталога, чтобы оформить заказ.</p>
    <a href="/catalog" class="btn">Перейти в каталог</a>
  </div>
<% } else { %>
  <div class="cart-grid">
    <div class="cart-main">
      <ul class="cart-items">
        <% items.forEach(i => { %>
          <li class="cart-item" data-product-id="<%= i.productId %>">
            <a href="/product/<%= i.slug %>" class="cart-item-image">
              <% if (i.image) { %>
                <img src="<%= i.image %>" alt="<%= i.name %>" loading="lazy">
              <% } else { %>
                <span class="cart-item-image-placeholder">Нет фото</span>
              <% } %>
            </a>

            <div class="cart-item-info">
              <a href="/product/<%= i.slug %>" class="cart-item-name"><%= i.name %></a>
              <div class="cart-item-price-unit"><%= i.price.toLocaleString('ru-RU') %> ₽ / шт.</div>
            </div>

            <div class="cart-item-qty">
              <form class="update-form qty-wrap qty-wrap-sm" data-product="<%= i.productId %>">
                <button type="button" class="qty-dec" aria-label="Меньше">−</button>
                <input type="number" name="qty" value="<%= i.qty %>" min="1" class="qty">
                <button type="button" class="qty-inc" aria-label="Больше">+</button>
              </form>
            </div>

            <div class="cart-item-sum">
              <%= (i.price * i.qty).toLocaleString('ru-RU') %> ₽
            </div>

            <button class="cart-item-remove remove-btn" data-product="<%= i.productId %>" title="Удалить">×</button>
          </li>
        <% }) %>
      </ul>

      <div class="cart-actions">
        <a href="/catalog" class="cart-continue">← Продолжить покупки</a>
      </div>
    </div>

    <aside class="cart-side">
      <div class="cart-summary">
        <h3>Итого</h3>

        <div class="summary-row">
          <span>Товаров: <%= items.reduce((s, i) => s + i.qty, 0) %></span>
        </div>
        <div class="summary-row summary-row-total">
          <span>К оплате</span>
          <span><strong><%= total.toLocaleString('ru-RU') %></strong> ₽</span>
        </div>

        <a href="/checkout" class="btn-checkout">Оформить заказ</a>

        <p class="checkout-agree">Доставка рассчитывается на следующем шаге</p>
      </div>
    </aside>
  </div>
<% } %>
