<div class="checkout-page">
  <h1>Оформление заказа</h1>

  <form method="post" action="/checkout" class="checkout-grid" id="checkout-form">
    <div class="checkout-main">

      <section class="checkout-block">
        <h2>1. Контактные данные</h2>

        <% if (savedProfile && (savedProfile.savedPhone || savedAddress.address)) { %>
          <div class="checkout-saved-hint">
            <div class="checkout-saved-icon">💾</div>
            <div class="checkout-saved-body">
              <strong>У вас сохранён адрес доставки</strong>
              <p>
                <%= savedProfile.savedName ? savedProfile.savedName : (user.name || user.email) %> ·
                <% if (savedAddress.postalCode) { %><%= savedAddress.postalCode %>, <% } %>
                <%= savedAddress.city %><% if (savedAddress.city && savedAddress.address) { %>, <% } %><%= savedAddress.address %>
                <% if (savedProfile.savedPhone) { %> · <%= savedProfile.savedPhone %><% } %>
              </p>
              <button type="button" class="btn btn-sm" id="fill-saved">Подставить в форму</button>
            </div>
          </div>
        <% } %>

        <div class="checkout-fields">
          <label>Имя * <input type="text" name="name" id="field-name" required value="<%= savedProfile && savedProfile.savedName ? savedProfile.savedName : (user ? (user.name || '') : '') %>" placeholder="Иван Иванов"></label>
          <label>Email * <input type="email" name="email" required value="<%= user ? user.email : '' %>" placeholder="you@example.com"></label>
          <label>Телефон * <input type="tel" name="phone" id="field-phone" required value="<%= savedProfile && savedProfile.savedPhone ? savedProfile.savedPhone : '' %>" placeholder="+7 (900) 000-00-00"></label>
          <label>Адрес доставки <input type="text" name="address" id="field-address" value="<%= savedAddress.address || '' %>" placeholder="Город, улица, дом, квартира"></label>
        </div>
      </section>

      <script>
      (function () {
        var saved = {
          name: <%= JSON.stringify((savedProfile && savedProfile.savedName) || (user ? (user.name || '') : '')) %>,
          phone: <%= JSON.stringify((savedProfile && savedProfile.savedPhone) || '') %>,
          address: <%= JSON.stringify([savedAddress.postalCode, savedAddress.city, savedAddress.address].filter(Boolean).join(', ')) %>
        };
        var btn = document.getElementById('fill-saved');
        if (btn) {
          btn.addEventListener('click', function () {
            var f1 = document.getElementById('field-name');
            var f2 = document.getElementById('field-phone');
            var f3 = document.getElementById('field-address');
            if (f1 && saved.name) f1.value = saved.name;
            if (f2 && saved.phone) f2.value = saved.phone;
            if (f3 && saved.address) f3.value = saved.address;
            btn.textContent = '✓ Подставлено';
            btn.disabled = true;
          });
        }
      })();
      </script>

      <section class="checkout-block checkout-gift-block">
        <label class="checkout-gift-toggle">
          <span class="checkout-gift-icon">🎁</span>
          <span class="checkout-gift-toggle-body">
            <span class="checkout-gift-toggle-title">Оформить как подарок</span>
            <span class="checkout-gift-toggle-desc">Отправим заказ другому человеку — с открыткой от вас</span>
          </span>
          <span class="checkout-gift-switch">
            <input type="checkbox" id="is-gift" name="isGift">
            <span class="checkout-gift-switch-track"></span>
          </span>
        </label>

        <div class="checkout-gift-fields" id="gift-fields" hidden>
          <div class="checkout-gift-grid">
            <label>
              <span>Имя получателя <em>*</em></span>
              <input type="text" name="recipientName" placeholder="Марии Ивановой">
            </label>
            <label>
              <span>Телефон получателя</span>
              <input type="tel" name="recipientPhone" placeholder="+7 (900) 000-00-00">
            </label>
          </div>

          <label class="checkout-gift-full">
            <span>Адрес доставки подарка <em>*</em></span>
            <input type="text" name="recipientAddress" placeholder="Город, улица, дом, квартира">
          </label>

          <label class="checkout-gift-full">
            <span>Поздравление <em class="muted">(необязательно)</em></span>
            <textarea name="giftMessage" rows="3" maxlength="500" placeholder="С днём рождения! Желаю…"></textarea>
          </label>

          <p class="checkout-gift-hint">
            💡 Письмо с чеком придёт вам. Получатель увидит вложенное поздравление — без цены.
          </p>
        </div>
      </section>

      <section class="checkout-block">
        <h2>2. Способ доставки</h2>
        <% if (!deliveries.length) { %>
          <p class="checkout-empty">Способы доставки не настроены</p>
        <% } else { %>
          <div class="choice-list">
            <% deliveries.forEach((d, idx) => { %>
              <label class="choice-item">
                <input type="radio" name="delivery" value="<%= d.code %>"
                       data-price="<%= d.type === 'free' ? 0 : d.price %>"
                       data-type="<%= d.type %>"
                       data-price-per-kg="<%= d.pricePerKg || 0 %>"
                       data-free-from="<%= d.freeFrom || '' %>"
                       <%= d.code === selectedDelivery ? 'checked' : '' %>>
                <span class="choice-icon"><%= d.icon || '🚚' %></span>
                <span class="choice-body">
                  <span class="choice-name"><%= d.name %></span>
                  <% if (d.description) { %><span class="choice-desc"><%= d.description %></span><% } %>
                  <% if (d.freeFrom) { %><span class="choice-hint">бесплатно от <%= d.freeFrom %> ₽</span><% } %>
                </span>
              </label>
            <% }) %>
          </div>
        <% } %>
      </section>

      <section class="checkout-block">
        <h2>3. Способ оплаты</h2>
        <% if (!payments.length) { %>
          <p class="checkout-empty">Способы оплаты не настроены</p>
        <% } else { %>
          <div class="choice-list">
            <% payments.forEach(p => { %>
              <label class="choice-item">
                <input type="radio" name="payment" value="<%= p.code %>"
                       <%= p.code === selectedPayment ? 'checked' : '' %>>
                <span class="choice-icon"><%= p.icon || '💳' %></span>
                <span class="choice-body">
                  <span class="choice-name"><%= p.name %></span>
                  <% if (p.description) { %><span class="choice-desc"><%= p.description %></span><% } %>
                </span>
              </label>
            <% }) %>
          </div>
        <% } %>
      </section>

      <section class="checkout-block">
        <h2>4. Комментарий к заказу</h2>
        <label>Пожелания к заказу (необязательно)
          <textarea name="comment" rows="3" placeholder="Например: позвонить за час до доставки"></textarea>
        </label>
      </section>
    </div>

    <aside class="checkout-side">
      <div class="checkout-summary">
        <h3>Ваш заказ</h3>

        <ul class="summary-items">
          <% items.forEach(it => { %>
            <li>
              <span class="summary-name"><%= it.name %></span>
              <span class="summary-qty">× <%= it.qty %></span>
              <span class="summary-price"><%= (it.price * it.qty).toLocaleString('ru-RU') %> ₽</span>
            </li>
          <% }) %>
        </ul>

        <div class="summary-rows">
          <div class="summary-row"><span>Товары</span><span><%= subtotal.toLocaleString('ru-RU') %> ₽</span></div>
          <div class="summary-row">
            <span>Доставка</span>
            <span id="delivery-fee-cell">
              <strong id="delivery-fee"><%= deliveryFee.toLocaleString('ru-RU') %></strong> ₽
              <small id="delivery-note" style="display:<%= deliveryNote ? 'block' : 'none' %>;color:#6b7280;font-size:12px"><%= deliveryNote %></small>
            </span>
          </div>

          <% if (loyalty && loyalty.enabled && loyalty.balance > 0 && maxPointsUsable > 0) { %>
            <div class="summary-row summary-loyalty">
              <label class="loyalty-toggle">
                <input type="checkbox" id="use-points-toggle">
                <span>Использовать баллы</span>
                <span class="loyalty-balance">(<%= loyalty.balance %> доступно)</span>
              </label>
              <div class="loyalty-slider" id="loyalty-slider" hidden>
                <input type="range" id="points-range" name="usePoints" min="0" max="<%= maxPointsUsable %>" value="0" step="1">
                <div class="loyalty-slider-info">
                  <span><strong id="points-value">0</strong> баллов</span>
                  <span class="loyalty-discount">−<strong id="points-discount">0</strong> ₽</span>
                </div>
                <div class="loyalty-max-hint">
                  Макс. к списанию: <strong><%= maxPointsUsable %></strong> б.
                  (<%= loyalty.maxPayPercent %>% от заказа)
                </div>
              </div>
            </div>
          <% } %>

          <div class="summary-row summary-row-total">
            <span>Итого</span>
            <span><strong id="total"><%= total.toLocaleString('ru-RU') %></strong> ₽</span>
          </div>
        </div>

        <button type="submit" class="btn-checkout">Оформить заказ</button>

        <p class="checkout-agree">
          Нажимая кнопку, вы соглашаетесь с <a href="/page/privacy-policy" target="_blank">политикой конфиденциальности</a> и обработкой персональных данных.
        </p>
      </div>
    </aside>
  </form>
</div>

<script>
(function () {
  var SUBTOTAL = <%= subtotal %>;
  var WEIGHT = <%= weight %>;
  var POINT_VALUE = <%= (loyalty && loyalty.pointValue) || 1 %>;
  var deliveryCost = <%= deliveryFee %>;

  function calcFee(radio) {
    var type = radio.dataset.type;
    var price = Number(radio.dataset.price) || 0;
    var pricePerKg = Number(radio.dataset.pricePerKg) || 0;
    var freeFrom = radio.dataset.freeFrom ? Number(radio.dataset.freeFrom) : null;
    if (freeFrom && SUBTOTAL >= freeFrom) return { cost: 0, note: 'бесплатно от ' + freeFrom + ' ₽' };
    if (type === 'free') return { cost: 0, note: '' };
    if (type === 'flat') return { cost: price, note: '' };
    if (type === 'weight') return { cost: Math.round(WEIGHT * pricePerKg), note: 'за ' + WEIGHT.toFixed(2) + ' кг' };
    if (type === 'manager') return { cost: 0, note: 'уточнит менеджер' };
    return { cost: 0, note: '' };
  }

  function fmt(n) { return Number(n).toLocaleString('ru-RU'); }

  function getPointsDiscount() {
    var range = document.getElementById('points-range');
    if (!range || range.parentNode.hidden) return 0;
    return Math.floor(Number(range.value) || 0) * POINT_VALUE;
  }

  function updateTotals() {
    var radio = document.querySelector('input[name="delivery"]:checked');
    if (radio) {
      var r = calcFee(radio);
      deliveryCost = r.cost;
      document.getElementById('delivery-fee').textContent = fmt(r.cost);
      var noteEl = document.getElementById('delivery-note');
      noteEl.textContent = r.note;
      noteEl.style.display = r.note ? 'block' : 'none';
    }
    var discount = getPointsDiscount();
    var total = Math.max(0, SUBTOTAL + deliveryCost - discount);
    document.getElementById('total').textContent = fmt(total);
  }

  document.querySelectorAll('input[name="delivery"]').forEach(function (r) {
    r.addEventListener('change', updateTotals);
  });

  // Тоггл баллов
  var toggle = document.getElementById('use-points-toggle');
  var slider = document.getElementById('loyalty-slider');
  var range = document.getElementById('points-range');
  var valEl = document.getElementById('points-value');
  var discEl = document.getElementById('points-discount');

  if (toggle && slider && range) {
    toggle.addEventListener('change', function () {
      slider.hidden = !toggle.checked;
      if (!toggle.checked) range.value = 0;
      valEl.textContent = range.value;
      discEl.textContent = fmt(Math.floor(Number(range.value)) * POINT_VALUE);
      updateTotals();
    });

    range.addEventListener('input', function () {
      valEl.textContent = range.value;
      discEl.textContent = fmt(Math.floor(Number(range.value)) * POINT_VALUE);
      updateTotals();
    });
  }
})();
</script>


<script>
(function () {
  var chk = document.getElementById('is-gift');
  var wrap = document.getElementById('gift-fields');
  if (!chk || !wrap) return;

  function sync() {
    wrap.hidden = !chk.checked;
    // При включённом подарке скрываем поле «Адрес доставки» в контактах — он становится необязательным
    var addr = document.getElementById('field-address');
    if (addr) {
      addr.closest('label').style.opacity = chk.checked ? '0.4' : '1';
      var note = addr.closest('label').querySelector('.checkout-address-note');
      if (chk.checked && !note) {
        var p = document.createElement('small');
        p.className = 'checkout-address-note';
        p.style.color = '#6b7280';
        p.style.fontSize = '12px';
        p.textContent = 'Игнорируется — используется адрес получателя ниже';
        addr.closest('label').appendChild(p);
      } else if (!chk.checked && note) {
        note.remove();
      }
    }
  }

  chk.addEventListener('change', sync);
  sync();
})();
</script>