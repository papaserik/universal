generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("USER")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  orders    Order[]
  posts     BlogPost[]
}

model Category {
  id        Int        @id @default(autoincrement())
  slug      String     @unique
  name      String
  parentId  Int?
  parent    Category?  @relation("CatTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CatTree")
  products  Product[]
  sort      Int        @default(0)
  seoTitle  String?
  seoDesc   String?
  createdAt DateTime   @default(now())
}

model Product {
  id              Int             @id @default(autoincrement())
  slug            String          @unique
  sku             String?         @unique
  name            String
  description     String?
  price           Float
  oldPrice        Float?
  stock           Int             @default(0)
  weight          Float           @default(0.5)
  images          String          @default("[]")
  categoryId      Int?
  category        Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  options         ProductOption[]
  seoTitle        String?
  seoDesc         String?
  seoKeywords     String?
  marketplace     String?
  marketplaceUrl  String?
  marketplaceLinks String  @default("[]")
  published       Boolean         @default(true)
  sort            Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([categoryId, published])
  @@index([price])
}

model Option {
  id       Int             @id @default(autoincrement())
  name     String
  slug     String          @unique
  values   OptionValue[]
  products ProductOption[]
}

model OptionValue {
  id             Int             @id @default(autoincrement())
  optionId       Int
  option         Option          @relation(fields: [optionId], references: [id], onDelete: Cascade)
  value          String
  slug           String
  productOptions ProductOption[]

  @@unique([optionId, slug])
}

model ProductOption {
  productId Int
  optionId  Int
  valueId   Int
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  option    Option      @relation(fields: [optionId], references: [id], onDelete: Cascade)
  value     OptionValue @relation(fields: [valueId], references: [id], onDelete: Cascade)

  @@id([productId, optionId, valueId])
}

model Order {
  id          Int         @id @default(autoincrement())
  number      String      @unique
  userId      Int?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  email       String
  phone       String
  name        String
  address     String?
  items       OrderItem[]
  subtotal    Float
  deliveryFee Float       @default(0)
  total       Float
  status      String      @default("NEW")
  payment     String      @default("cod")
  delivery    String      @default("flat")
  comment     String?
  ip          String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status, createdAt])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int?
  name      String
  price     Float
  qty       Int
}

model BlogPost {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  title     String
  excerpt   String?
  content   String
  cover     String?
  authorId  Int?
  author    User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  blogCategoryId Int?
  blogCategory   BlogCategory? @relation(fields: [blogCategoryId], references: [id], onDelete: SetNull)
  published Boolean  @default(true)
  views     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  seoTitle  String?
  seoDesc   String?

  @@index([published, createdAt])
}

model Page {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  title     String
  content   String
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  seoTitle  String?
  seoDesc   String?
}

model Setting {
  key   String @id
  value String
}

model MenuItem {
  id       Int    @id @default(autoincrement())
  label    String
  url      String
  position String @default("main")
  sort     Int    @default(0)
  parentId Int?
}

model DeliveryMethod {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  description String?
  type        String   @default("flat")
  price       Float    @default(0)
  freeFrom    Float?
  pricePerKg  Float?
  icon        String?
  active      Boolean  @default(true)
  sort        Int      @default(0)
  createdAt   DateTime @default(now())
}

model PaymentMethod {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  description String?
  type        String   @default("cod")
  config      String   @default("{}")
  icon        String?
  active      Boolean  @default(true)
  sort        Int      @default(0)
  createdAt   DateTime @default(now())
}

model BlogCategory {
  id        Int          @id @default(autoincrement())
  slug      String       @unique
  name      String
  parentId  Int?
  parent    BlogCategory? @relation("BlogCatTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  BlogCategory[] @relation("BlogCatTree")
  posts     BlogPost[]
  sort      Int          @default(0)
  createdAt DateTime     @default(now())
}

model Marketplace {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  name      String
  iconUrl   String?
  color     String   @default("#0f172a")
  sort      Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Cart {
  id          Int        @id @default(autoincrement())
  sessionId   String     @unique
  userId      Int?
  email       String?
  name        String?
  phone       String?
  items       CartItem[]
  total       Float      @default(0)
  itemCount   Int        @default(0)
  status      String     @default("active")
  convertedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  @@index([status, updatedAt])
}

model CartItem {
  id        Int     @id @default(autoincrement())
  cartId    Int
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId Int?
  name      String
  slug      String?
  price     Float
  qty       Int
}

model LoginCode {
  id        Int      @id @default(autoincrement())
  email     String
  code      String
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  ip        String?
  @@index([email, code])
}

model Subscriber {
  id             Int      @id @default(autoincrement())
  email          String?  @unique
  name           String?
  phone          String?
  telegramChatId String?
  source         String   @default("site")
  confirmed      Boolean  @default(false)
  unsubscribed   Boolean  @default(false)
  tags           String   @default("[]")
  createdAt      DateTime @default(now())
  @@index([confirmed, unsubscribed])
}

model Newsletter {
  id           Int      @id @default(autoincrement())
  subject      String
  content      String
  channels     String   @default("[\"email\"]")
  status       String   @default("draft")
  sentAt       DateTime?
  recipients   Int      @default(0)
  delivered    Int      @default(0)
  failed       Int      @default(0)
  createdAt    DateTime @default(now())
}

model NewsletterLog {
  id           Int      @id @default(autoincrement())
  newsletterId Int
  subscriberId Int
  channel      String
  status       String
  error        String?
  sentAt       DateTime @default(now())
  @@index([newsletterId])
}
