generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("USER")
  active    Boolean  @default(true)
  avatar    String?
  refCode   String?  @unique
  referredById Int?
  pendingReferralPoints Int @default(0)
  referralsSent     Referral[] @relation("ReferralsSent")
  referralReceived  Referral?  @relation("ReferralReceived")
  savedAddress String @default("{}")
  savedPhone   String?
  savedName    String?
  createdAt DateTime @default(now())
  orders    Order[]
  posts     BlogPost[]
  loyalty   LoyaltyTransaction[]
  favorites Favorite[]
  pushSubscriptions PushSubscription[]
}

model Category {
  id        Int        @id @default(autoincrement())
  slug      String     @unique
  name      String
  imageUrl  String?
  parentId  Int?
  parent    Category?  @relation("CatTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CatTree")
  products  Product[]
  sort      Int        @default(0)
  seoTitle  String?
  seoDesc   String?
  createdAt DateTime   @default(now())
}

model Product {
  id              Int             @id @default(autoincrement())
  slug            String          @unique
  sku             String?         @unique
  name            String
  description     String?
  price           Float
  oldPrice        Float?
  stock           Int             @default(0)
  weight          Float           @default(0.5)
  images          String          @default("[]")
  categoryId      Int?
  category        Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  options         ProductOption[]
  reviews         Review[]
  favorites       Favorite[]
  seoTitle        String?
  seoDesc         String?
  seoKeywords     String?
  marketplace     String?
  marketplaceUrl  String?
  externalIds     String   @default("{}")
  syncStatus      String   @default("local")
  marketplaceLinks String  @default("[]")
  published       Boolean         @default(true)
  sort            Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([categoryId, published])
  @@index([price])
  brandId      Int?
  brand        Brand?          @relation(fields: [brandId], references: [id], onDelete: SetNull)
  tags         ProductTag[]
}

model Option {
  id       Int             @id @default(autoincrement())
  name     String
  slug     String          @unique
  values   OptionValue[]
  products ProductOption[]
}

model OptionValue {
  id             Int             @id @default(autoincrement())
  optionId       Int
  option         Option          @relation(fields: [optionId], references: [id], onDelete: Cascade)
  value          String
  slug           String
  productOptions ProductOption[]

  @@unique([optionId, slug])
}

model ProductOption {
  productId Int
  optionId  Int
  valueId   Int
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  option    Option      @relation(fields: [optionId], references: [id], onDelete: Cascade)
  value     OptionValue @relation(fields: [valueId], references: [id], onDelete: Cascade)

  @@id([productId, optionId, valueId])
}

model Order {
  id          Int         @id @default(autoincrement())
  number      String      @unique
  source      String      @default("own")
  externalId  String?
  externalNumber String?
  commissionPercent Float  @default(0)
  commissionAmount  Float  @default(0)
  netProfit   Float       @default(0)
  commissionStatus String @default("calculated")
  userId      Int?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  email       String
  phone       String
  name        String
  address     String?
  items       OrderItem[]
  subtotal    Float
  deliveryFee Float       @default(0)
  total       Float
  status      String      @default("NEW")
  payment     String      @default("cod")
  delivery    String      @default("flat")
  comment     String?
  ip          String?
  pointsUsed  Int         @default(0)
  pointsEarned Int        @default(0)
  pointsDiscount Float    @default(0)
  isGift          Boolean  @default(false)
  recipientName   String?
  recipientPhone  String?
  recipientAddress String?
  giftMessage     String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status, createdAt])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int?
  name      String
  price     Float
  qty       Int
}

model BlogPost {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  title     String
  excerpt   String?
  content   String
  cover     String?
  authorId  Int?
  author    User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  blogCategoryId Int?
  blogCategory   BlogCategory? @relation(fields: [blogCategoryId], references: [id], onDelete: SetNull)
  published Boolean  @default(true)
  views     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  seoTitle  String?
  seoDesc   String?

  @@index([published, createdAt])
}

model Page {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  title     String
  content   String
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  seoTitle  String?
  seoDesc   String?
}

model Setting {
  key   String @id
  value String
}

model MenuItem {
  id       Int    @id @default(autoincrement())
  label    String
  url      String
  position String @default("main")
  sort     Int    @default(0)
  parentId Int?
}

model DeliveryMethod {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  description String?
  type        String   @default("flat")
  price       Float    @default(0)
  freeFrom    Float?
  pricePerKg  Float?
  icon        String?
  active      Boolean  @default(true)
  sort        Int      @default(0)
  createdAt   DateTime @default(now())
}

model PaymentMethod {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  description String?
  type        String   @default("cod")
  config      String   @default("{}")
  icon        String?
  active      Boolean  @default(true)
  sort        Int      @default(0)
  createdAt   DateTime @default(now())
}

model BlogCategory {
  id        Int          @id @default(autoincrement())
  slug      String       @unique
  name      String
  parentId  Int?
  parent    BlogCategory? @relation("BlogCatTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  BlogCategory[] @relation("BlogCatTree")
  posts     BlogPost[]
  sort      Int          @default(0)
  createdAt DateTime     @default(now())
}

model Marketplace {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  name      String
  iconUrl   String?
  color     String   @default("#0f172a")
  sort      Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Cart {
  id          Int        @id @default(autoincrement())
  pushSentAt  DateTime?
  sessionId   String     @unique
  userId      Int?
  email       String?
  name        String?
  phone       String?
  items       CartItem[]
  total       Float      @default(0)
  itemCount   Int        @default(0)
  status      String     @default("active")
  convertedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  @@index([status, updatedAt])
}

model CartItem {
  id        Int     @id @default(autoincrement())
  cartId    Int
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId Int?
  name      String
  slug      String?
  price     Float
  qty       Int
}

model LoginCode {
  id        Int      @id @default(autoincrement())
  email     String
  code      String
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  ip        String?
  @@index([email, code])
}

model Subscriber {
  id             Int      @id @default(autoincrement())
  email          String?  @unique
  name           String?
  phone          String?
  telegramChatId String?
  source         String   @default("site")
  confirmed      Boolean  @default(false)
  unsubscribed   Boolean  @default(false)
  tags           String   @default("[]")
  createdAt      DateTime @default(now())
  @@index([confirmed, unsubscribed])
}

model Newsletter {
  id           Int      @id @default(autoincrement())
  subject      String
  content      String
  channels     String   @default("[\"email\"]")
  status       String   @default("draft")
  sentAt       DateTime?
  recipients   Int      @default(0)
  delivered    Int      @default(0)
  failed       Int      @default(0)
  createdAt    DateTime @default(now())
}

model NewsletterLog {
  id           Int      @id @default(autoincrement())
  newsletterId Int
  subscriberId Int
  channel      String
  status       String
  error        String?
  sentAt       DateTime @default(now())
  @@index([newsletterId])
}

model OrderStatus {
  id            Int      @id @default(autoincrement())
  code          String   @unique
  name          String
  color         String   @default("#6b7280")
  icon          String?
  sort          Int      @default(0)
  active        Boolean  @default(true)
  isDefault     Boolean  @default(false)
  isFinal       Boolean  @default(false)
  notifyClient  Boolean  @default(false)
  notifyAdmin   Boolean  @default(false)
  emailSubject  String?
  emailBody     String?
  createdAt     DateTime @default(now())
}

model EmailTemplate {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  name        String
  description String?
  subject     String
  body        String
  active      Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model LoyaltyTransaction {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  points      Int
  type        String
  reason      String
  description String?
  orderId     Int?
  createdAt   DateTime @default(now())
  @@index([userId, createdAt])
}

model LoyaltyLevel {
  id              Int      @id @default(autoincrement())
  name            String
  slug            String   @unique
  minPoints       Int      @default(0)
  color           String   @default("#a16207")
  icon            String?
  discountPercent Float    @default(0)
  cashbackPercent Float    @default(0)
  sort            Int      @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
}

model Review {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    Int?
  orderId   Int?
  name      String
  email     String?
  rating    Int      @default(5)
  text      String
  approved  Boolean  @default(false)
  pointsAwarded Boolean @default(false)
  createdAt DateTime @default(now())
  @@index([productId, approved])
}

model Banner {
  id           Int      @id @default(autoincrement())
  title        String
  subtitle     String?
  body         String?
  ctaText      String?
  ctaUrl       String?
  imageUrl     String?
  bgColor      String   @default("#0f172a")
  textColor    String   @default("#ffffff")
  textPosition String   @default("left")
  overlay      Int      @default(40)
  layout       String   @default("hero")
  sort         Int      @default(0)
  active       Boolean  @default(true)
  startsAt     DateTime?
  endsAt       DateTime?
  createdAt    DateTime @default(now())
}

model ImageVariant {
  id         Int      @id @default(autoincrement())
  original   String
  path       String
  format     String
  width      Int
  height     Int
  size       Int
  variant    String   @default("original")
  createdAt  DateTime @default(now())
  @@index([original])
}

model Brand {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  name      String
  logoUrl   String?
  description String?
  country   String?
  sort      Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  products  Product[]
}

model Tag {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  name      String
  color     String   @default("#6b7280")
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  products  ProductTag[]
}

model ProductTag {
  productId Int
  tagId     Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@id([productId, tagId])
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model Referral {
  id             Int      @id @default(autoincrement())
  inviterId      Int
  invitedId      Int      @unique
  status         String   @default("registered")
  firstOrderId   Int?
  invitedAt      DateTime @default(now())
  convertedAt    DateTime?
  totalEarned    Float    @default(0)

  inviter        User     @relation("ReferralsSent",     fields: [inviterId], references: [id], onDelete: Cascade)
  invited        User     @relation("ReferralReceived", fields: [invitedId], references: [id], onDelete: Cascade)

  @@index([inviterId, status])
}

model MarketplaceIntegration {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  name        String
  enabled     Boolean  @default(false)
  direction   String   @default("both")
  strategy    String   @default("merge")
  config      String   @default("{}")
  commissionPercent Float @default(0)
  syncOrders  Boolean  @default(true)
  syncStock   Boolean  @default(true)
  syncPrice   Boolean  @default(false)
  syncInterval String  @default("manual")
  lastSyncAt  DateTime?
  lastSyncStatus String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MarketplaceSyncLog {
  id            Int      @id @default(autoincrement())
  integrationId Int?
  marketplace   String
  direction     String
  action        String
  strategy      String?
  total         Int      @default(0)
  created       Int      @default(0)
  updated       Int      @default(0)
  skipped       Int      @default(0)
  failed        Int      @default(0)
  status        String   @default("started")
  message       String?
  details       String   @default("[]")
  startedAt     DateTime @default(now())
  finishedAt    DateTime?

  @@index([marketplace, startedAt])
  @@index([integrationId])
}

model PushSubscription {
  id         Int      @id @default(autoincrement())
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  active     Boolean  @default(true)
  lastSentAt DateTime?
  failCount  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, active])
}
